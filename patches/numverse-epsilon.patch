+namespace Home {
+namespace Verse {
+
+// Something to start: a calculator app or an external app (.nwa game)
+struct Item {
+  enum class Kind : uint8_t { None, Builtin, External };
+  Kind kind;
+  int16_t index;  // app index in AppsContainer, or external app index
+  bool isNone() const { return kind == Kind::None; }
+};
+
+constexpr Item k_noItem = {Item::Kind::None, 0};
+
+/* The NUMVERSE world. Its state is static: it survives leaving the home app
+ * to run a calculator app or a game. The engine (textures, buffers) lives in
+ * the home app itself, which is only in RAM while the world is shown. */
+namespace Shell {
+
+void attach(Engine* engine);
+void detach();
+void leave();
+// Returns true if the event was used
+bool handleEvent(Ion::Events::Event event);
+// One animation step. Returns true to redraw the screen.
+bool frame();
+// Animation period in ms
+int framePeriod();
+void render(Band& band);
+// Time taken by the last full redraw (adapts the resolution)
+void setLastRedrawDuration(int ms);
+// The app to open, set by handleEvent; the caller opens it right away
+Item takeLaunch();
+
+}  // namespace Shell
+
+}  // namespace Verse
+}  // namespace Home
