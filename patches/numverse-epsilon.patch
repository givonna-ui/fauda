+}  // namespace
+
+/* =============================================================== shell */
+
+namespace Shell {
+
+void attach(Engine* engine) {
+  s_engine = engine;
+  s_launch = k_noItem;
+  s.now = s.last = clockMs();
+  buildItems();
+  bool first = !s.initialized;
+  if (first) {
+    s.initialized = true;
+    s.random = 0x9E3779B9u ^ Ion::random();
+    if (s.random == 0) {
+      s.random = 1;
+    }
+    s.theme = Theme::Synthwave;
+    s.hud = true;
+    placeAt(3.5f, 5.5f, 0.f);
+    resetGhost();
+    s.mode = Mode::Boot;
+    s.modeStart = s.now;
+    s.lastInput = s.now;
+  }
+  setupEngine();
+  s_engine->setWave(s.theme == Theme::Abyss);
+  if (!first) {
+    if (s.mode != Mode::Boot) {
+      s.mode = Mode::World;
+    }
+    s.lastInput = s.now;
+    s.worldStart = s.now;
+    s.queueLength = 0;
+    s.message.text = nullptr;
+    if (s.launches > 0) {
+      say(k_back[rnd() % (sizeof(k_back) / sizeof(k_back[0]))], Mood::Happy, 1);
+    }
+  }
+  frame();
+#if !PLATFORM_DEVICE
+  const char* shots = getenv("NUMVERSE_SHOTS");
+  if (shots && first) {
+    s_shotDir = shots;
+    photoSession();
+    exit(0);
+  }
+#endif
+}
+
+void detach() { s_engine = nullptr; }
+
+void setLastRedrawDuration(int ms) {
+  if (!s_engine || s.mode == Mode::Boot || s.mode == Mode::Credits) {
+    return;
+  }
+  // Smoothed frame time, in ms * 4
+  s.redrawAverage = (s.redrawAverage * 3 + ms * 4) / 4;
+  if (!s_engine->lowResolution() && s.redrawAverage > 60 * 4) {
+    s_engine->setLowResolution(true);
+  } else if (s_engine->lowResolution() && s.redrawAverage < 22 * 4) {
+    s_engine->setLowResolution(false);
+  }
+}
+
+void leave() {}
+
+Item takeLaunch() {
+  Item it = s_launch;
+  s_launch = k_noItem;
+  return it;
+}
+
+int framePeriod() {
+  if (s.mode == Mode::World && s.now - s.lastInput > 40000 &&
+      s.now > s.partyUntil) {
+    return 160;  // BIP sleeps: save the battery
+  }
+  return 30;
+}
+
+bool handleEvent(Event e) {
+  if (!s_engine) {
+    return false;
+  }
+  if (!e.isKeyboardEvent() || e == Events::OnOff) {
+    return false;
+  }
+  if (e == Events::Shift || e == Events::Alpha || e == Events::AlphaCaps) {
+    return false;
+  }
+  s.now = clockMs();
+  s.lastInput = s.now;
+  Ion::Keyboard::State keys = scanKeys();
+  switch (s.mode) {
+    case Mode::Boot:
+      startWorld(true);
+      return true;
+    case Mode::Credits:
+      if (e == Events::OK || e == Events::Back || e == Events::EXE ||
+          e == Events::Home) {
+        s.mode = Mode::World;
+        say("ARC-EN-CIEL d\xC3\xA9""bloqu\xC3\xA9 !\nAppuie sur 6. Vas-y.",
+            Mood::Love, 3);
+      }
+      return true;
+    case Mode::Map:
+      if (e == Events::Toolbox || e == Events::Back || e == Events::OK ||
+          e == Events::Home) {
+        s.mode = Mode::World;
+      }
+      return true;
+    case Mode::Teleport: {
+      int count = entryCount();
+      if (e == Events::Up || e == Events::Down) {
+        int d = e == Events::Up ? -1 : 1;
+        s.menuSelected = (s.menuSelected + d + count) % count;
+        if (s.menuSelected < s.menuScroll) {
+          s.menuScroll = s.menuSelected;
+        } else if (s.menuSelected >= s.menuScroll + k_menuRows) {
+          s.menuScroll = s.menuSelected - k_menuRows + 1;
+        }
+      } else if (e == Events::OK || e == Events::EXE) {
+        activateEntry(entryAt(s.menuSelected));
+      } else if (e == Events::Back || e == Events::Home) {
+        s.mode = Mode::World;
+      }
+      return true;
+    }
+    default:
+      break;
+  }
+  // World
+  if (e == Events::Up || e == Events::Down) {
+    Key k = e == Events::Up ? Key::Up : Key::Down;
+    if (!keys.keyDown(k)) {
+      // The key is already up (replayed events): one step
+      float d = e == Events::Up ? 0.45f : -0.3f;
+      if (!tryMove(cosf(s.cam.angle) * d, sinf(s.cam.angle) * d)) {
+        say(k_bump[rnd() % (sizeof(k_bump) / sizeof(k_bump[0]))],
+            Mood::Angry, 1);
+      }
+    }
+    return true;
+  }
+  if (e == Events::Left || e == Events::Right) {
+    Key k = e == Events::Left ? Key::Left : Key::Right;
+    if (!keys.keyDown(k)) {
+      s.cam.angle += e == Events::Left ? -0.3f : 0.3f;
+    }
+    return true;
+  }
+  if (e == Events::OK) {
+    interact();
+    return true;
+  }
+  if (e == Events::EXE) {
+    if (s.cam.z <= 0.55f) {
+      s.vz = 2.3f;
+      if ((rnd() % 4) == 0) {
+        say("Wouhou !", Mood::Wow, 1);
+      }
+    }
+    return true;
+  }
+  if (e == Events::Back || e == Events::Home) {
+    s.mode = Mode::Teleport;
+    s.menuSelected = 0;
+    s.menuScroll = 0;
+    return true;
+  }
+  if (e == Events::Toolbox) {
+    s.mode = Mode::Map;
+    return true;
+  }
+  if (e == Events::Var) {
+    s.hud = !s.hud;
+    return true;
+  }
+  if (e == Events::Ans) {
+    say(k_jokes[s.jokeIndex % (sizeof(k_jokes) / sizeof(k_jokes[0]))],
+        Mood::Happy, 2);
+    s.jokeIndex++;
+    return true;
+  }
+  if (e == Events::Pi) {
+    s.partyUntil = s.now + 5000;
+    burst(k_screenWidth / 2, k_screenHeight / 2, 30);
+    say("\xCF\x80 ! \xCF\x80 ! \xCF\x80 !\n3,14159265358979...", Mood::Wow, 2);
+    return true;
+  }
+  constexpr Event k_themeKeys[] = {Events::One, Events::Two, Events::Three,
+                                   Events::Four, Events::Five, Events::Six};
+  for (int i = 0; i < k_numberOfThemes; i++) {
+    if (e == k_themeKeys[i]) {
+      if (static_cast<int>(s.theme) != i) {
+        setTheme(static_cast<Theme>(i), true);
+      }
+      return true;
+    }
+  }
+  return true;
+}
+
+bool frame() {
+  if (!s_engine) {
+    return false;
+  }
+  s.now = clockMs();
+  float dt = (s.now - s.last) / 1000.f;
+  if (dt > 0.1f) {
+    dt = 0.1f;
+  }
+  s.last = s.now;
+  updateMessages();
+  if (s.mode == Mode::Boot) {
+    if (s.now - s.modeStart > 7000) {
+      startWorld(true);
+    }
+    return true;
+  }
+  if (s.mode == Mode::World) {
+    updateWorld(dt, scanKeys());
+  } else if (s.mode != Mode::Credits) {
+    updateGhost(dt);
+  }
+  if (s.mode == Mode::World && s.now - s.worldStart < 1600 && s.launches == 0) {
+    // Intro: one full turn on arrival
+    float t = (s.now - s.worldStart) / 1600.f;
+    float ease = 1.f - (1.f - t) * (1.f - t) * (1.f - t);
+    s.cam.angle = (1.f - ease) * -2.f * k_pi;
+    if (s.cam.angle < 0) {
+      s.cam.angle += 2 * k_pi;
+    }
+  }
+  updateParticles();
+  if (s.mode != Mode::Credits) {
+    // Sprites: coins and the Glitch
+    Sprite sprites[k_maxCoins + 1];
+    int n = 0;
+    for (int i = 0; i < s_numberOfCoins; i++) {
+      if (!(s.coins & (1 << i))) {
+        sprites[n++] = {s_coinX[i] + 0.5f, s_coinY[i] + 0.5f,
+                        0.32f + 0.05f * sinf(s.now * 0.003f + i), 0.36f,
+                        SpriteKind::Coin, static_cast<uint8_t>(i)};
+      }
+    }
+    sprites[n++] = {s.ghostX, s.ghostY,
+                    0.5f + 0.06f * sinf(s.now * 0.004f), 0.8f,
+                    SpriteKind::Ghost, 0};
+    s_engine->prepare(s.cam, s.now, sprites, n);
+  }
+  return true;
+}
+
+void render(Band& b) {
+  if (!s_engine) {
+    fill(b, b.area(), rgb(0x000000));
+    return;
+  }
+  switch (s.mode) {
+    case Mode::Boot:
+      renderBoot(b);
+      return;
+    case Mode::Credits:
+      renderCredits(b);
+      return;
+    case Mode::Warp:
+      renderWarp(b);
+      return;
+    default:
+      break;
+  }
+  s_engine->render(b);
+  renderParticles(b);
+  if (s.now < s.glitchUntil) {
+    glitchBand(b);
+  }
+  if (s.mode == Mode::World && s.hud) {
+    drawHud(b);
+  } else if (s.mode == Mode::World && !s.hud) {
+    // Photo mode: only a discreet badge
+    text(b, "MODE PHOTO  (var)", k_screenWidth - 6, k_screenHeight - 16,
+         rgb(0xFFFFFF), Small, Align::Right, k_screenWidth, 140);
+  }
+  if (s.mode == Mode::Teleport) {
+    drawTeleport(b);
+  } else if (s.mode == Mode::Map) {
+    drawMap(b);
+  }
+  if (s.now < s.flashUntil) {
+    fill(b, b.area(), rgb(0xFFFFFF), static_cast<int>(s.flashUntil - s.now));
+  }
+}
+
+}  // namespace Shell
+
+}  // namespace Verse
+}  // namespace Home
