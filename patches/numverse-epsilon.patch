+void renderCredits(Band& b) {
+  uint32_t e = s.now - s.modeStart;
+  const Rect& a = b.area();
+  for (int y = a.y; y < a.bottom(); y++) {
+    fill(b, {0, y, k_screenWidth, 1}, mix(rgb(0x14002A), rgb(0x000000), y));
+    for (int k = 0; k < 3; k++) {
+      uint32_t h = hash(y * 3 + k);
+      if ((h & 7) == 0) {
+        int x = static_cast<int>((h >> 8) % k_screenWidth -
+                                 (e / (20 + (h & 31))) % k_screenWidth);
+        x = (x + 2 * k_screenWidth) % k_screenWidth;
+        fill(b, {x, y, 1, 1}, rgb(0xFFFFFF), 120 + (h >> 24) % 120);
+      }
+    }
+  }
+  constexpr const char* k_credits[] = {
+      "#NUMVERSE",
+      "",
+      "#R\xC3\xA9""alis\xC3\xA9 par",
+      "une IA qui ne dort jamais",
+      "pendant que tu dormais",
+      "",
+      "#Moteur 3D",
+      "un raycaster fait main",
+      "320 rayons par image",
+      "",
+      "#R\xC3\xB4le principal",
+      "BIP",
+      "",
+      "#Le m\xC3\xA9""chant",
+      "le Glitch",
+      "",
+      "#Remerciements",
+      "\xCF\x80 (3,14159265...)",
+      "ton prof de maths",
+      "toi, pour les 10 \xCF\x80",
+      "",
+      "#R\xC3\xA9""alit\xC3\xA9 d\xC3\xA9""bloqu\xC3\xA9""e",
+      "ARC-EN-CIEL : touche 6",
+      "",
+      "",
+      "#FIN ?",
+  };
+  int count = sizeof(k_credits) / sizeof(k_credits[0]);
+  int base = k_screenHeight - static_cast<int>(e / 28);
+  for (int i = 0; i < count; i++) {
+    int y = base + i * 22;
+    if (y < -24 || y > k_screenHeight) {
+      continue;
+    }
+    const char* line = k_credits[i];
+    if (line[0] == '#') {
+      text(b, line + 1, k_screenWidth / 2, y,
+           hsv(i * 30 + static_cast<int>(e / 10), 160, 255), Large,
+           Align::Center);
+    } else {
+      text(b, line, k_screenWidth / 2, y + 2, rgb(0xE8E0FF), Small,
+           Align::Center);
+    }
+  }
+}
