+#include "engine.h"
+
+#include <math.h>
+#include <string.h>
+
+namespace Home {
+namespace Verse {
+
+namespace {
+
+/* The world. One character per cell:
+ *   #  wall          %  accent wall      $  secret room wall
+ *   M  monolith      T  pi trophy        =  secret door (10 pi coins)
+ *   a..n  portals to the calculator apps
+ *   A..H  arcade cabinets (the .nwa games)
+ *   .  floor   *  pi coin   S  start   &  the Glitch (a ghost) */
+constexpr char k_map[k_mapHeight][k_mapWidth + 1] = {
+    "########################",  // 0
+    "#%a%b%c%d%e%#%%A%B%C%D%#",  // 1
+    "#...........###.......*#",  // 2
+    "f...........m##........E",  // 3
+    "#...........###........#",  // 4
+    "#..S..M................F",  // 5
+    "#.....M................#",  // 6
+    "g...........n##.G.H....#",  // 7
+    "#..........*###........#",  // 8
+    "#...........#######.####",  // 9
+    "#%h%i%j%k%l%#######.####",  // 10
+    "########.*......#..&..*#",  // 11
+    "$$$$$$$.#.####.#.###.#.#",  // 12
+    "$.....$.#.*..#.#...#...#",  // 13
+    "$..T..$.####.#.#.#.###.#",  // 14
+    "$.....=......#.*.#.....#",  // 15
+    "$.....$#####.#####.###.#",  // 16
+    "$.....$*....*.....*.#*.#",  // 17
+    "$$$$$$$#################",  // 18
+};
+
+constexpr float k_plane = 0.66f;
+constexpr float k_projection = (k_screenWidth / 2) / k_plane;  // px per unit
+constexpr int k_circumference = 1523;  // 2 pi * k_projection, for the sky
+
+inline uint32_t hash(uint32_t x) {
+  x ^= x >> 16;
+  x *= 0x7feb352dU;
+  x ^= x >> 15;
+  x *= 0x846ca68bU;
+  x ^= x >> 16;
+  return x;
+}
+inline uint32_t hash2(int a, int b) {
+  return hash(static_cast<uint32_t>(a) * 73856093U ^
+              static_cast<uint32_t>(b) * 19349663U);
+}
+
+KDColor lerp(uint32_t a, uint32_t b, int t, int n) {
+  if (n <= 0) {
+    return rgb(a);
+  }
+  int ra = (a >> 16) & 255, ga = (a >> 8) & 255, ba = a & 255;
+  int rb = (b >> 16) & 255, gb = (b >> 8) & 255, bb = b & 255;
+  return KDColor::RGB888(ra + (rb - ra) * t / n, ga + (gb - ga) * t / n,
+                         ba + (bb - ba) * t / n);
+}
+
+void ramp(KDColor* palette, int start, int count, uint32_t from,
+          uint32_t to) {
+  for (int i = 0; i < count; i++) {
+    palette[start + i] = lerp(from, to, i, count - 1);
+  }
+}
+
+// 7 x 7 pi, for the coins
+constexpr uint8_t k_piGlyph[7] = {0x00, 0x7F, 0x7F, 0x36, 0x36, 0x36, 0x66};
+
+float normalizeAngle(float a) {
+  while (a > 3.14159265f) {
+    a -= 6.2831853f;
+  }
+  while (a < -3.14159265f) {
+    a += 6.2831853f;
+  }
+  return a;
+}
+
+}  // namespace
+
+/* ------------------------------------------------------------------- map */
+
+char Engine::initialCell(int x, int y) {
+  if (x < 0 || y < 0 || x >= k_mapWidth || y >= k_mapHeight) {
+    return '#';
+  }
+  return k_map[y][x];
+}
+
+char Engine::cell(int x, int y) const {
+  char c = initialCell(x, y);
+  if (c == '*' || c == 'S' || c == '&') {
+    return '.';
+  }
+  if (c == '=' && m_doorOpen) {
+    return '.';
+  }
+  return c;
+}
+
+bool Engine::isSolid(char c) {
+  return !(c == '.' || c == '*' || c == 'S' || c == '&');
+}
+
+/* ----------------------------------------------------------------- setup */
+
+void Engine::setup(Theme theme, bool doorOpen) {
+  m_doorOpen = doorOpen;
+  m_wave = false;
+  m_lowResolution = false;
+  m_flicker = 0;
+  m_time = 0;
+  m_numberOfSprites = 0;
+  m_target = {0, 0, 0, 100.f};
+  for (int i = 0; i < k_appSlots; i++) {
+    m_appUsed[i] = false;
+  }
+  for (int i = 0; i < k_gameSlots; i++) {
+    m_gameState[i] = -1;
+  }
+  glyphMask("\xCF\x80", m_monolithMask);  // pi
+  glyphMask("10\xCF\x80", m_doorMask);
+  // Swirl of the portals: angle + radius, in 1/16 turns
+  for (int v = 0; v < k_tex; v++) {
+    for (int u = 0; u < k_tex; u++) {
+      float dx = u - 15.5f, dy = (v - 17.f) * 0.95f;
+      float a = atan2f(dy, dx) / 6.2831853f;  // -0.5 .. 0.5
+      float r = sqrtf(dx * dx + dy * dy);
+      m_swirl[v * k_tex + u] =
+          static_cast<uint8_t>(static_cast<int>(a * 32.f + r * 0.9f + 64.f));
+    }
+  }
+  setTheme(theme);
+}
+
+void Engine::setDoorOpen(bool open) { m_doorOpen = open; }
+
+void Engine::setAppSymbol(int slot, const char* symbol) {
+  if (slot < 0 || slot >= k_appSlots) {
+    return;
+  }
+  m_appUsed[slot] = symbol != nullptr;
+  uint32_t* mask = m_appSymbols[slot];
+  glyphMask(symbol, mask);
+  // Dark outline: the mask grown by one texel, minus the mask
+  for (int v = 0; v < 32; v++) {
+    uint32_t grown = mask[v] | (mask[v] << 1) | (mask[v] >> 1);
+    if (v > 0) {
+      grown |= mask[v - 1];
+    }
+    if (v < 31) {
+      grown |= mask[v + 1];
+    }
+    m_appOutlines[slot][v] = grown & ~mask[v];
+  }
+}
+
+void Engine::setGame(int slot, const Ion::ExternalApps::App* app) {
+  if (slot < 0 || slot >= k_gameSlots) {
+    return;
+  }
+  if (app == nullptr) {
+    m_gameState[slot] = -1;
+    return;
+  }
+  m_gameState[slot] = gameIconTexture(*app, m_gameIcons[slot], 24, 18) ? 1 : 0;
+}
+
+void Engine::setTheme(Theme theme) {
+  m_theme = theme;
+  generateTextures();
+  buildShades();
+}
+
+/* -------------------------------------------------------------- textures */
+
+void Engine::generateTextures() {
+  KDColor* p = m_palette;
+  uint8_t* wall = m_textures[TexWall];
+  uint8_t* accent = m_textures[TexAccent];
+  // Shared colours: hazard, metal, neon trim
+  ramp(p, 48, 4, 0xB89400, 0xFFD84A);
+  ramp(p, 52, 4, 0x0E0E12, 0x2A2A30);
+  ramp(p, 56, 4, 0x07070C, 0x34344A);
+  uint32_t neon = 0x22E6FF, neon2 = 0xFF3CAC;
+  m_hasCeiling = false;
+  m_fogK = 1.f;
+
+  switch (m_theme) {
+    case Theme::Synthwave: {
+      ramp(p, 0, 16, 0x0E041C, 0x4A1A72);
+      ramp(p, 16, 8, 0x08364A, 0x5FF8FF);
+      ramp(p, 24, 8, 0x4A0C34, 0xFF4FB8);
+      ramp(p, 32, 8, 0x04010A, 0x1E0838);
+      ramp(p, 40, 8, 0x3A0A50, 0xFF3CD6);
+      m_fog = rgb(0x1E0830);
+      m_fogK = 0.7f;
+      for (int v = 0; v < k_tex; v++) {
+        for (int u = 0; u < k_tex; u++) {
+          int i = v * k_tex + u;
+          uint8_t c = 2 + v * 5 / 32 + (hash2(u, v) & 1);
+          if (v == 9 || v == 10) {
+            c = v == 9 ? 23 : 21;
+          } else if (u == 0 || v == 0 || v == 31) {
+            c = 9;
+          } else if (u == 16 && v > 10) {
+            c = 1;
+          }
+          wall[i] = c;
+          int d = (u + (v > 16 ? 32 - v : v)) % 12;
+          accent[i] = d < 2 ? 30 - d * 2 : 2 + (hash2(u, v) & 1);
+          if (v == 0 || v == 31) {
+            accent[i] = 27;
+          }
+          uint8_t f = 32 + (hash2(u + 99, v) & 1);
+          if (u == 0 || v == 0) {
+            f = 47;
+          } else if (u == 1 || v == 1 || u == 31 || v == 31) {
+            f = 43;
+          }
+          m_floor[i] = f;
+        }
+      }
+      for (int y = 0; y < k_screenHeight; y++) {
+        int h = k_screenHeight / 2;
+        m_skyRows[y] = y < h * 6 / 10 ? lerp(0x07021A, 0x3C0F5C, y, h * 6 / 10)
+                                      : lerp(0x3C0F5C, 0xFF6A3D,
+                                             y - h * 6 / 10, h - h * 6 / 10);
+      }
+      break;
+    }
+    case Theme::Liminal: {
+      ramp(p, 0, 16, 0x5C4E1C, 0xE6D27A);
+      ramp(p, 16, 8, 0x30240E, 0x8A6D3B);
+      ramp(p, 24, 8, 0x4E4018, 0xA8923E);
+      ramp(p, 32, 8, 0x473C1E, 0xA8955C);
+      ramp(p, 40, 8, 0x6E6A52, 0xFFFDF0);
+      m_fog = rgb(0x5A5028);
+      m_fogK = 1.35f;
+      m_hasCeiling = true;
+      neon = 0xFFF5B0;
+      neon2 = 0xFFFFFF;
+      for (int v = 0; v < k_tex; v++) {
+        for (int u = 0; u < k_tex; u++) {
+          int i = v * k_tex + u;
+          uint32_t h = hash2(u, v);
+          uint8_t c = 11 + ((u % 8) < 4 ? 1 : 0) + (h & 1);
+          if (u % 8 == 0) {
+            c = 8;
+          }
+          if ((u / 4 + v / 6) % 5 == 0 && (u % 8) == 2) {
+            c = 13;
+          }
+          if (v >= 28) {
+            c = v == 28 ? 22 : 18 + (h & 1);
+          }
+          wall[i] = c;
+          // Stains
+          float dx = u - 20.f, dy = v - 9.f;
+          float d = dx * dx * 0.8f + dy * dy;
+          uint8_t a = c;
+          if (v < 28 && d < 60.f + (h & 15)) {
+            a = c > 4 ? c - 4 : 1;
+          }
+          accent[i] = a;
+          m_floor[i] = 33 + (hash2(u + 7, v + 3) & 3);
+          uint8_t ce = 44 + (h & 1);
+          if (u % 16 == 0 || v % 16 == 0) {
+            ce = 41;
+          } else if (u >= 3 && u <= 12 && v >= 5 && v <= 26) {
+            ce = 47;
+          }
+          m_ceiling[i] = ce;
+        }
+      }
+      break;
+    }
+    case Theme::Matrix: {
+      ramp(p, 0, 16, 0x000000, 0x5BFF9A);
+      ramp(p, 16, 16, 0x001408, 0x0A6A30);
+      ramp(p, 32, 8, 0x000000, 0x00200C);
+      ramp(p, 40, 8, 0x00200C, 0x00FF55);
+      m_fog = rgb(0x000000);
+      m_fogK = 1.15f;
+      neon = 0x3BFF7A;
+      neon2 = 0xC8FFD8;
+      for (int v = 0; v < k_tex; v++) {
+        for (int u = 0; u < k_tex; u++) {
+          int i = v * k_tex + u;
+          uint32_t h = hash2(u, v);
+          wall[i] = (u == 0 || v == 0 || v == 31) ? 20 : k_rain;
+          uint8_t a = 17 + (h & 1);
+          if ((v % 8 == 4 && (u / 4) % 3 != 0) ||
+              (u % 8 == 2 && (v / 4) % 2 == 0)) {
+            a = 27;
+          }
+          if ((u % 8 == 2 && v % 8 == 4)) {
+            a = 12;
+          }
+          accent[i] = a;
+          m_floor[i] = (u == 0 || v == 0) ? 45 : 32 + (h & 1);
+        }
+      }
+      for (int y = 0; y < k_screenHeight; y++) {
+        m_skyRows[y] = rgb(0x000000);
+      }
+      break;
+    }
+    case Theme::Abyss: {
+      ramp(p, 0, 16, 0x061A26, 0x4A9CC0);
+      ramp(p, 16, 8, 0x08301A, 0x4FC46A);
+      ramp(p, 24, 8, 0x501830, 0xFF8A70);
+      ramp(p, 32, 8, 0x2E2818, 0xE6D298);
+      ramp(p, 40, 8, 0x0B3550, 0x9FE8FF);
+      m_fog = rgb(0x0A3048);
+      m_fogK = 1.7f;
+      neon = 0x6BF3FF;
+      neon2 = 0xFFB0E0;
+      for (int v = 0; v < k_tex; v++) {
+        for (int u = 0; u < k_tex; u++) {
+          int i = v * k_tex + u;
+          uint32_t h = hash2(u, v);
+          int row = v / 8;
+          int uu = (u + (row & 1) * 8) % 16;
+          uint8_t c = 6 + (h & 3) + ((hash2(row, (u + (row & 1) * 8) / 16) & 3));
+          if (v % 8 == 0 || uu == 0) {
+            c = 2;
+          }
+          if (v > 22 && (h % 31) < static_cast<uint32_t>((v - 22) * 3)) {
+            c = 18 + (h & 3);
+          }
+          wall[i] = c;
+          float dx = (u % 16) - 8.f, dy = v - 20.f;
+          accent[i] = (dx * dx + dy * dy < 30.f && (h & 3)) ? 26 + (h & 3) : c;
+          float s = sinf(u * 0.4f + v * 0.15f) + sinf(v * 0.55f);
+          m_floor[i] = 34 + static_cast<int>((s + 2.f) * 1.2f) + (h & 1);
+        }
+      }
+      for (int y = 0; y < k_screenHeight; y++) {
+        m_skyRows[y] = lerp(0x8FE2FF, 0x0A3048, y, k_screenHeight / 2);
+      }
+      break;
+    }
+    case Theme::Paper: {
+      ramp(p, 0, 16, 0x8E8E88, 0xFBFAF3);
+      ramp(p, 16, 8, 0xB7CDEB, 0x3A6FC4);
+      ramp(p, 24, 4, 0xF08A8A, 0xD83A3A);
+      ramp(p, 28, 4, 0x1A1A2E, 0x4A4A60);
+      ramp(p, 32, 8, 0xA8A8A0, 0xF7F5EC);
+      ramp(p, 40, 8, 0xC9DAF0, 0x7FA2D8);
+      m_fog = rgb(0xF4F2EA);
+      m_fogK = 0.85f;
+      neon = 0x3A6FC4;
+      neon2 = 0xD83A3A;
+      for (int v = 0; v < k_tex; v++) {
+        for (int u = 0; u < k_tex; u++) {
+          int i = v * k_tex + u;
+          uint8_t c = 15;
+          if (v % 8 == 0) {
+            c = 21;
+          } else if (v % 2 == 0) {
+            c = 17;
+          }
+          if (u == 5) {
+            c = 26;
+          }
+          if (u == 0 || u == 31 || v == 31) {
+            c = 28;
+          }
+          wall[i] = c;
+          uint8_t a = (u % 4 == 0 || v % 4 == 0) ? 18 : 15;
+          if (u == 0 || u == 31 || v == 31 || v == 0) {
+            a = 28;
+          }
+          accent[i] = a;
+          m_floor[i] = (u % 8 == 0 || v % 8 == 0) ? 42 : 39;
+        }
+      }
+      for (int y = 0; y < k_screenHeight; y++) {
+        m_skyRows[y] = lerp(0xFFFFFF, 0xDCE7F5, y, k_screenHeight / 2);
+      }
+      break;
+    }
+    default: {  // Rainbow
+      ramp(p, 0, 16, 0x101010, 0xFFFFFF);
+      ramp(p, 16, 16, 0x200030, 0xFF00FF);
+      ramp(p, 32, 8, 0x000000, 0x202020);
+      ramp(p, 40, 8, 0x404040, 0xFFFFFF);
+      m_fog = rgb(0x120018);
+      m_fogK = 0.6f;
+      neon = 0xFFFFFF;
+      neon2 = 0xFF00FF;
+      for (int v = 0; v < k_tex; v++) {
+        for (int u = 0; u < k_tex; u++) {
+          int i = v * k_tex + u;
+          wall[i] = (u == 0 || v == 0) ? 0 : k_rainbow;
+          accent[i] = ((u / 8 + v / 8) & 1) ? k_rainbow : 15;
+          m_floor[i] = ((u / 16 + v / 16) & 1) ? 32 : 47;
+        }
+      }
+      break;
+    }
+  }
+  m_neon = rgb(neon);
+  ramp(p, 60, 3, neon & 0x7F7F7F, neon);
+  p[63] = rgb(0xFFFFFF);
+  // Portal colours: neon -> neon2 -> neon
+  for (int i = 0; i < 16; i++) {
+    int t = i < 8 ? i : 15 - i;
+    m_portalRamp[i] = lerp(neon, neon2, t, 7);
+  }
+
+  // Shared textures, coloured by the palette of the theme
+  for (int v = 0; v < k_tex; v++) {
+    for (int u = 0; u < k_tex; u++) {
+      int i = v * k_tex + u;
+      uint32_t h = hash2(u + 31, v + 17);
+      uint32_t bit = 0x80000000u >> u;
+      // Monolith: obsidian, neon edges, a glowing pi
+      uint8_t m = 56 + (h % 3 == 0 ? 1 : 0);
+      if (u == 1 || u == 30) {
+        m = 61;
+      }
+      if (m_monolithMask[v] & bit) {
+        m = k_glyph;
+      }
+      m_textures[TexMonolith][i] = m;
+      // Door: hazard stripes, a lock and "10 pi"
+      uint8_t d = ((u + v) / 4) % 2 ? 50 : 53;
+      float dx = u - 15.5f, dy = v - 16.5f;
+      if (dx * dx + dy * dy < 150.f) {
+        d = 56;
+      }
+      if (m_doorMask[v] & bit) {
+        d = k_glyph;
+      }
+      m_textures[TexDoor][i] = d;
+      // Secret room: rainbow walls with dark seams
+      m_textures[TexSecret][i] = (u % 16 == 0 || v % 16 == 0) ? 57 : k_rainbow;
+      // Trophy: a rainbow pi on white marble
+      m_textures[TexTrophy][i] =
+          (m_monolithMask[v] & bit) ? k_rainbow : (h % 7 == 0 ? 59 : 63);
+      // Portal: arch in the accent wall, swirl inside
+      float ex = (u - 15.5f) / 12.5f, ey = (v - 17.f) / 14.f;
+      float e = ex * ex + ey * ey;
+      uint8_t pt = accent[i];
+      if (pt >= 64) {
+        pt = 2;
+      }
+      if (e < 1.f) {
+        pt = k_portalInside;
+      } else if (e < 1.35f) {
+        pt = e < 1.15f ? 62 : 60;
+      }
+      m_textures[TexPortal][i] = pt;
+      // Arcade cabinet
+      uint8_t c = 57;
+      if (u < 2 || u > 29) {
+        c = 58;
+      } else if (v >= 2 && v <= 5 && u >= 3 && u <= 28) {
+        c = k_glyph;
+      } else if (v >= 8 && v <= 25 && u >= 4 && u <= 27) {
+        c = k_screenInside;
+      } else if (v >= 7 && v <= 26 && u >= 3 && u <= 28) {
+        c = 52;
+      } else if (v >= 28 && v <= 29 && (u == 9 || u == 10)) {
+        c = 51;
+      } else if (v >= 28 && v <= 29 && (u == 20 || u == 22)) {
+        c = 62;
+      }
+      m_textures[TexCabinet][i] = c;
+    }
+  }
+}
+
+void Engine::buildShades() {
+  for (int l = 0; l < 16; l++) {
+    int t = l * 230 / 15;
+    for (int i = 0; i < 64; i++) {
+      m_shades[l][i] = mix(m_palette[i], m_fog, t);
+    }
+  }
+}
+
+/* --------------------------------------------------------------- prepare */
+
+void Engine::prepare(const Camera& cam, uint32_t timeMs, const Sprite* sprites,
+                     int numberOfSprites) {
+  m_cam = cam;
+  m_time = timeMs;
+  m_dirX = cosf(cam.angle);
+  m_dirY = sinf(cam.angle);
+  m_planeX = -m_dirY * k_plane;
+  m_planeY = m_dirX * k_plane;
+  m_horizon = k_screenHeight / 2;
+
+  int columnStep = m_lowResolution ? 2 : 1;
+  for (int x = 0; x < k_screenWidth; x += columnStep) {
+    float cameraX = 2.f * x / k_screenWidth - 1.f;
+    float rx = m_dirX + m_planeX * cameraX;
+    float ry = m_dirY + m_planeY * cameraX;
+    int mx = static_cast<int>(cam.x), my = static_cast<int>(cam.y);
+    float ddx = rx == 0.f ? 1e30f : fabsf(1.f / rx);
+    float ddy = ry == 0.f ? 1e30f : fabsf(1.f / ry);
+    int stepX, stepY;
+    float sdx, sdy;
+    if (rx < 0) {
+      stepX = -1;
+      sdx = (cam.x - mx) * ddx;
+    } else {
+      stepX = 1;
+      sdx = (mx + 1.f - cam.x) * ddx;
+    }
+    if (ry < 0) {
+      stepY = -1;
+      sdy = (cam.y - my) * ddy;
+    } else {
+      stepY = 1;
+      sdy = (my + 1.f - cam.y) * ddy;
+    }
+    int side = 0;
+    char hit = '#';
+    for (int i = 0; i < 64; i++) {
+      if (sdx < sdy) {
+        sdx += ddx;
+        mx += stepX;
+        side = 0;
+      } else {
+        sdy += ddy;
+        my += stepY;
+        side = 1;
+      }
+      hit = cell(mx, my);
+      if (isSolid(hit)) {
+        break;
+      }
+    }
+    float dist = side == 0 ? sdx - ddx : sdy - ddy;
+    if (dist < 0.05f) {
+      dist = 0.05f;
+    }
+    float wallX = side == 0 ? cam.y + dist * ry : cam.x + dist * rx;
+    wallX -= floorf(wallX);
+    int u = static_cast<int>(wallX * k_tex);
+    // Mirror where needed so that the symbols read left to right
+    if ((side == 0 && rx < 0) || (side == 1 && ry > 0)) {
+      u = k_tex - 1 - u;
+    }
+    Column& c = m_columns[x];
+    c.distance = dist;
+    float scale = k_projection / dist;
+    float top = m_horizon - (1.f - cam.z) * scale;
+    float bottom = m_horizon + cam.z * scale;
+    c.top = static_cast<int16_t>(top < -4000 ? -4000 : top);
+    c.bottom = static_cast<int16_t>(bottom > 4000 ? 4000 : bottom);
+    c.vStep = static_cast<int32_t>(k_tex * 65536.f / scale);
+    c.u = static_cast<uint8_t>(u & (k_tex - 1));
+    int shade = static_cast<int>(dist * m_fogK) + (side ? 1 : 0);
+    c.shade = static_cast<uint8_t>(shade > 15 ? 15 : shade);
+    c.slot = -1;
+    c.cellHash = static_cast<uint8_t>(hash2(mx, my));
+    if (hit >= 'a' && hit <= 'n') {
+      c.slot = hit - 'a';
+      c.tex = m_appUsed[c.slot] ? TexPortal : TexAccent;
+    } else if (hit >= 'A' && hit <= 'H') {
+      c.slot = hit - 'A';
+      c.tex = TexCabinet;
+    } else {
+      switch (hit) {
+        case '%': c.tex = TexAccent; break;
+        case '$': c.tex = TexSecret; break;
+        case 'M': c.tex = TexMonolith; break;
+        case 'T': c.tex = TexTrophy; break;
+        case '=': c.tex = TexDoor; break;
+        default: c.tex = TexWall; break;
+      }
+    }
+    if (x == k_screenWidth / 2) {
+      m_target = {hit, mx, my, dist};
+    }
+    if (columnStep == 2) {
+      m_columns[x + 1] = c;
+    }
+  }
+
+  m_pulse = static_cast<int16_t>(180 + 70.f * sinf(m_time * 0.006f));
+
+  // Sky: per column data and the sun
+  int offset = static_cast<int>(cam.angle * k_projection);
+  for (int x = 0; x < k_screenWidth; x++) {
+    int wx = ((x + offset) % k_circumference + k_circumference) % k_circumference;
+    m_skyWx[x] = static_cast<int16_t>(wx);
+    if (m_theme == Theme::Abyss) {
+      float ray = sinf(wx * 0.045f + m_time * 0.0007f) +
+                  sinf(wx * 0.021f - m_time * 0.0011f);
+      m_skyRay[x] = ray > 1.3f ? static_cast<uint8_t>((ray - 1.3f) * 200.f) : 0;
+    }
+  }
+  float sunAzimuth = m_theme == Theme::Paper ? -0.9f : 0.f;
+  float sunDiff = normalizeAngle(sunAzimuth - cam.angle);
+  m_sunVisible = fabsf(sunDiff) < 1.1f;
+  m_sunX = m_sunVisible ? static_cast<int16_t>(k_screenWidth / 2 +
+                                               tanf(sunDiff) * k_projection)
+                        : 0;
+
+  // Sprites, sorted from the farthest
+  m_numberOfSprites = 0;
+  for (int i = 0; i < numberOfSprites && m_numberOfSprites < k_maxSprites;
+       i++) {
+    const Sprite& s = sprites[i];
+    float relX = s.x - cam.x, relY = s.y - cam.y;
+    float depth = m_dirX * relX + m_dirY * relY;
+    if (depth < 0.15f) {
+      continue;
+    }
+    float tx = (m_dirX * relY - m_dirY * relX) / k_plane;
+    int sx = static_cast<int>(k_screenWidth / 2 * (1.f + tx / depth));
+    int half = static_cast<int>(s.size * k_projection / depth / 2.f);
+    if (half < 1 || sx + half < 0 || sx - half >= k_screenWidth || half > 400) {
+      continue;
+    }
+    int sy = static_cast<int>(m_horizon + (cam.z - s.z) * k_projection / depth);
+    Projected& p = m_sprites[m_numberOfSprites++];
+    p.sx = sx;
+    p.sy = sy;
+    p.half = half;
+    p.depth = depth;
+    p.kind = s.kind;
+    p.param = s.param;
+    int shade = static_cast<int>(depth * m_fogK);
+    p.shade = shade > 15 ? 15 : shade;
+    float spin = fabsf(cosf(m_time * 0.004f + p.param));
+    p.spin = spin < 0.12f ? 0.12f : spin;
+  }
+  for (int i = 1; i < m_numberOfSprites; i++) {
+    Projected p = m_sprites[i];
+    int j = i - 1;
+    while (j >= 0 && m_sprites[j].depth < p.depth) {
+      m_sprites[j + 1] = m_sprites[j];
+      j--;
+    }
+    m_sprites[j + 1] = p;
+  }
+}
+
+/* ---------------------------------------------------------------- render */
+
+KDColor Engine::wallTexel(const Column& c, int y) const {
+  int v = (((y - c.top) * c.vStep) >> 16) & (k_tex - 1);
+  int u = c.u;
+  uint8_t t = m_textures[c.tex][v * k_tex + u];
+  int shade = c.shade + m_flicker;
+  if (shade > 15) {
+    shade = 15;
+  }
+  if (t < 64) {
+    return m_shades[shade][t];
+  }
+  KDColor col;
+  int glow = shade * 9;  // emissive texels only fade a little
+  switch (t) {
+    case k_portalInside: {
+      if (c.slot >= 0 && (m_appSymbols[c.slot][v] & (0x80000000u >> u))) {
+        col = KDColor::RGB888(255, 255, 255);
+      } else if (c.slot >= 0 &&
+                 (m_appOutlines[c.slot][v] & (0x80000000u >> u))) {
+        col = KDColor::RGB888(10, 4, 24);
+      } else {
+        int s = (m_swirl[v * k_tex + u] + static_cast<int>(m_time / 70)) & 15;
+        col = m_portalRamp[s];
+        // dark centre: depth
+        int dx = u - 16, dy = v - 17;
+        int d2 = dx * dx + dy * dy;
+        if (d2 < 30) {
+          col = mix(col, rgb(0x000000), 160 - d2 * 5);
+        }
+      }
+      break;
+    }
+    case k_screenInside: {
+      int sx = u - 4, sy = v - 8;
+      int state = c.slot >= 0 ? m_gameState[c.slot] : -1;
+      if (state == 1) {
+        col = KDColor::RGB16(m_gameIcons[c.slot][sy * 24 + sx]);
+        if (sy % 3 == 0) {
+          col = mix(col, rgb(0x000000), 60);  // scanlines
+        }
+      } else if (state == 0) {
+        int s = (sx + sy * 2 + static_cast<int>(m_time / 60)) & 15;
+        col = m_portalRamp[s];
+      } else {
+        // No game: TV static
+        uint32_t h = hash2(sx + static_cast<int>(m_time / 50) * 37, sy);
+        int g = 40 + (h & 127);
+        col = KDColor::RGB888(g, g, g);
+      }
+      break;
+    }
+    case k_rainbow: {
+      col = hsv((u + v) * 6 + static_cast<int>(m_time / 8), 210, 255);
+      break;
+    }
+    case k_rain: {
+      uint32_t h = hash(u * 977 + c.cellHash * 131);
+      int speed = 6 + (h & 7);
+      int head = static_cast<int>((m_time * speed / 600 + h) % 40);
+      int d = head - v;
+      if (d < 0) {
+        d += 40;
+      }
+      if (d < 14 &&
+          (hash2(u + c.cellHash, (v + static_cast<int>(m_time / 400)) / 2) & 3)) {
+        int g = d == 0 ? 255 : 220 - d * 14;
+        col = d == 0 ? KDColor::RGB888(200, 255, 210)
+                     : KDColor::RGB888(0, g, g / 3);
+      } else {
+        col = KDColor::RGB888(0, 12, 4);
+      }
+      glow = shade * 14;
+      break;
+    }
+    default: {  // k_glyph
+      int pulse = m_pulse;
+      col = mix(rgb(0x000000), m_neon, pulse);
+      if (c.tex == TexDoor) {
+        col = KDColor::RGB888(pulse, 30, 40);
+      }
+      break;
+    }
+  }
+  return mix(col, m_fog, glow);
+}
+
+KDColor Engine::skyPixel(int x, int y) const {
+  int wx = m_skyWx[x];
+  switch (m_theme) {
+    case Theme::Synthwave: {
+      KDColor c = m_skyRows[y];
+      // Striped sun in the east
+      if (m_sunVisible) {
+        int sunX = m_sunX;
+        int sunY = m_horizon - 34;
+        int dx = x - sunX, dy = y - sunY;
+        constexpr int R = 44;
+        if (dx * dx + dy * dy < R * R) {
+          bool gap = dy > 0 && ((dy + static_cast<int>(m_time / 90)) % 9) <
+                                   (dy * 6 / R);
+          if (!gap) {
+            return lerp(0xFFE45C, 0xFF2E88, dy + R, 2 * R);
+          }
+        }
+      }
+      if (y < m_horizon - 50) {
+        uint32_t h = hash2(wx >> 1, y >> 1);
+        if ((h & 511) < 2) {
+          int tw = (h >> 12) & 1 ? 255 : 160 + ((m_time / 200 + h) & 63);
+          return KDColor::RGB888(tw, tw, 255);
+        }
+      }
+      return c;
+    }
+    case Theme::Matrix: {
+      int column = wx >> 2;
+      uint32_t h = hash(column + 1000);
+      int speed = 30 + (h & 63);
+      int span = m_horizon + 40;
+      int head = static_cast<int>((m_time * speed / 1000 + h) % span);
+      int d = head - y;
+      if (d >= 0 && d < 40 && (wx & 3) != 3 &&
+          (hash2(column, (y >> 2) + static_cast<int>(m_time / 300)) & 1)) {
+        int g = d == 0 ? 255 : 200 - d * 5;
+        return d == 0 ? KDColor::RGB888(190, 255, 200)
+                      : KDColor::RGB888(0, g, g / 4);
+      }
+      return KDColor::RGB888(0, 0, 0);
+    }
+    case Theme::Abyss: {
+      KDColor c = m_skyRows[y];
+      if (m_skyRay[x]) {
+        c = mix(c, rgb(0xCFF6FF), m_skyRay[x]);
+      }
+      return c;
+    }
+    case Theme::Paper: {
+      KDColor c = m_skyRows[y];
+      if (m_sunVisible) {
+        int sunX = m_sunX;
+        int sunY = 40;
+        int dx = x - sunX, dy = y - sunY;
+        int d2 = dx * dx + dy * dy;
+        if (d2 > 17 * 17 && d2 < 19 * 19) {
+          return rgb(0x2A2A40);
+        }
+        // Doodled rays
+        if (d2 > 24 * 24 && d2 < 36 * 36) {
+          float a = atan2f(dy, dx) + m_time * 0.0005f;
+          float k = a * 8.f / 6.2831853f;
+          if (fabsf(k - roundf(k)) < 0.06f) {
+            return rgb(0xE8A33A);
+          }
+        }
+      }
+      // Notebook lines in the sky, why not
+      if (y % 16 == 0) {
+        return mix(c, rgb(0x9DB8E6), 90);
+      }
+      return c;
+    }
+    default:  // Rainbow
+      return hsv(y * 2 + wx / 4 + static_cast<int>(m_time / 10), 170, 120);
+  }
+}
+
+KDColor Engine::spritePixel(const Projected& p, int x, int y, bool* hit) const {
+  float u = (x - p.sx) / static_cast<float>(p.half);
+  float v = (y - p.sy) / static_cast<float>(p.half);
+  *hit = false;
+  KDColor col;
+  switch (p.kind) {
+    case SpriteKind::Coin: {
+      float uu = u / p.spin;
+      float r2 = uu * uu + v * v;
+      if (r2 > 0.81f) {
+        return col;
+      }
+      *hit = true;
+      if (r2 > 0.55f) {
+        col = rgb(0xC08A10);
+      } else {
+        col = rgb(0xFFD23F);
+        int gx = static_cast<int>((uu + 0.6f) * 5.84f);
+        int gy = static_cast<int>((v + 0.6f) * 5.84f);
+        if (gx >= 0 && gx < 7 && gy >= 0 && gy < 7 &&
+            (k_piGlyph[gy] & (0x40 >> gx))) {
+          col = rgb(0xA0640A);
+        }
+        if (uu < -0.15f && v < -0.2f && r2 < 0.35f && r2 > 0.12f) {
+          col = rgb(0xFFF6C8);
+        }
+      }
+      break;
+    }
+    case SpriteKind::Ghost: {
+      // Glitch slices
+      uint32_t slice = hash2(y >> 2, static_cast<int>(m_time / 90));
+      if ((slice & 7) == 0) {
+        u += ((slice >> 8) & 1) ? 0.25f : -0.25f;
+      }
+      bool inside;
+      if (v < 0) {
+        inside = u * u + v * v < 0.8f;
+      } else {
+        inside = fabsf(u) < 0.894f &&
+                 v < 0.75f + 0.15f * sinf(u * 11.f + m_time * 0.012f);
+      }
+      if (!inside) {
+        return col;
+      }
+      *hit = true;
+      col = hsv(static_cast<int>(m_time / 6) + y * 4, 90, 255);
+      if ((slice & 7) == 0) {
+        col = KDColor::RGB888(255 - col.red(), 255 - col.green(),
+                              255 - col.blue());
+      }
+      float ex = fabsf(u) - 0.33f, ey = (v + 0.2f) * 0.6f;
+      if (ex * ex + ey * ey < 0.022f) {
+        col = rgb(0x0A0014);
+      }
+      float mx = u, my = (v - 0.28f) * 1.4f;
+      if (mx * mx + my * my < 0.025f) {
+        col = rgb(0x0A0014);
+      }
+      break;
+    }
+    default: {  // Spark
+      float d = fabsf(u) + fabsf(v);
+      if (d > 1.f || (fabsf(u) > 0.15f && fabsf(v) > 0.15f)) {
+        return col;
+      }
+      *hit = true;
+      col = hsv(p.param * 40 + static_cast<int>(m_time / 4), 120, 255);
+      break;
+    }
+  }
+  return mix(col, m_fog, p.shade * 10);
+}
+
+void Engine::render(Band& b) const {
+  const Rect& area = b.area();
+  float rx0 = m_dirX - m_planeX, ry0 = m_dirY - m_planeY;
+  float rx1 = m_dirX + m_planeX, ry1 = m_dirY + m_planeY;
+  for (int y = area.y; y < area.bottom(); y++) {
+    KDColor* row = b.row(y);
+    // Floor or ceiling under / above the horizon on this row
+    bool below = y > m_horizon;
+    bool plane = below || m_hasCeiling;
+    int32_t fx = 0, fy = 0, sx = 0, sy = 0;
+    int planeShade = 15;
+    const uint8_t* planeTex = below ? m_floor : m_ceiling;
+    if (plane && y != m_horizon) {
+      float rowDist = below ? m_cam.z * k_projection / (y - m_horizon + 0.5f)
+                            : (1.f - m_cam.z) * k_projection /
+                                  (m_horizon - y + 0.5f);
+      float wx = m_cam.x + rowDist * rx0, wy = m_cam.y + rowDist * ry0;
+      fx = static_cast<int32_t>(wx * 65536.f);
+      fy = static_cast<int32_t>(wy * 65536.f);
+      sx = static_cast<int32_t>(rowDist * (rx1 - rx0) / k_screenWidth * 65536.f);
+      sy = static_cast<int32_t>(rowDist * (ry1 - ry0) / k_screenWidth * 65536.f);
+      planeShade = static_cast<int>(rowDist * m_fogK) + m_flicker;
+      if (planeShade > 15) {
+        planeShade = 15;
+      }
+    }
+    const KDColor* shades = m_shades[planeShade];
+    int step = m_lowResolution ? 2 : 1;
+    if (step == 2) {
+      sx *= 2;
+      sy *= 2;
+    }
+    for (int x = 0; x < k_screenWidth; x += step) {
+      const Column& c = m_columns[x];
+      if (y >= c.top && y < c.bottom) {
+        row[x] = wallTexel(c, y);
+      } else if (plane && y != m_horizon) {
+        int tu = (fx >> 11) & (k_tex - 1);
+        int tv = (fy >> 11) & (k_tex - 1);
+        uint8_t t = planeTex[tv * k_tex + tu];
+        if (t < 64) {
+          row[x] = shades[t];
+        } else {
+          row[x] = hsv((fx >> 13) + (fy >> 13) + m_time / 8, 200, 220);
+        }
+      } else {
+        row[x] = y == m_horizon && !m_hasCeiling && m_theme == Theme::Synthwave
+                     ? rgb(0xFF5FD0)
+                     : skyPixel(x, y);
+      }
+      if (step == 2) {
+        row[x + 1] = row[x];
+      }
+      fx += sx;
+      fy += sy;
+    }
+    // Sprites
+    for (int i = 0; i < m_numberOfSprites; i++) {
+      const Projected& p = m_sprites[i];
+      if (y < p.sy - p.half || y > p.sy + p.half) {
+        continue;
+      }
+      int x0 = p.sx - p.half < 0 ? 0 : p.sx - p.half;
+      int x1 = p.sx + p.half >= k_screenWidth ? k_screenWidth - 1
+                                              : p.sx + p.half;
+      for (int x = x0; x <= x1; x++) {
+        if (p.depth >= m_columns[x].distance) {
+          continue;
+        }
+        bool hit;
+        KDColor col = spritePixel(p, x, y, &hit);
+        if (hit) {
+          row[x] = p.kind == SpriteKind::Ghost
+                       ? KDColor::Blend(col, row[x], 215)
+                       : col;
+        }
+      }
+    }
+    // Underwater wobble
+    if (m_wave) {
+      int off = static_cast<int>(sinf(y * 0.09f + m_time * 0.004f) * 3.f);
+      if (off > 0) {
+        memmove(row + off, row, (k_screenWidth - off) * sizeof(KDColor));
+      } else if (off < 0) {
+        memmove(row, row - off, (k_screenWidth + off) * sizeof(KDColor));
+      }
+    }
+  }
+}
+
+}  // namespace Verse
+}  // namespace Home
diff --git a/epsilon/apps/home/verse/engine.h b/epsilon/apps/home/verse/engine.h
new file mode 100644
index 0000000000..9852e2b235
--- /dev/null
+++ b/epsilon/apps/home/verse/engine.h
@@ -0,0 +1,177 @@
+#pragma once
+
+/* NUMVERSE 3D engine: a textured raycaster (walls, floor, ceiling or sky,
+ * billboard sprites) that renders the world one band at a time.
+ *
+ * The world is a 24 x 19 grid. Walls are 1 unit high, the eye is at 0.5
+ * (higher while jumping). Every texture is generated procedurally for the
+ * current "reality" (theme): nothing is stored in flash but the map. */
+
+#include <ion/external_apps.h>
+#include <stdint.h>
+
+#include "gfx.h"
+
+namespace Home {
+namespace Verse {
+
+constexpr int k_mapWidth = 24;
+constexpr int k_mapHeight = 19;
+constexpr int k_tex = 32;
+
+// Portal slots in the map: 'a'..'n' calculator apps, 'A'..'H' games
+constexpr int k_appSlots = 14;
+constexpr int k_gameSlots = 8;
+constexpr int k_maxCoins = 10;
+
+enum class Theme : uint8_t {
+  Synthwave = 0,
+  Liminal,
+  Matrix,
+  Abyss,
+  Paper,
+  Rainbow,  // hidden: unlocked in the secret room
+  NumberOfThemes
+};
+constexpr int k_numberOfThemes = static_cast<int>(Theme::NumberOfThemes);
+
+struct Camera {
+  float x, y;   // position in cells
+  float angle;  // radians, 0 = +x (east)
+  float z;      // eye height, 0.5 = standing
+};
+
+enum class SpriteKind : uint8_t { Coin, Ghost, Spark };
+
+struct Sprite {
+  float x, y, z;  // z: height of the centre
+  float size;     // world size (1 = one cell)
+  SpriteKind kind;
+  uint8_t param;
+};
+
+// What the centre of the screen is looking at
+struct Target {
+  char cell;  // map character, 0 if nothing
+  int cx, cy;
+  float distance;
+};
+
+class Engine {
+ public:
+  constexpr static int k_maxSprites = 16;
+
+  void setup(Theme theme, bool doorOpen);
+  void setTheme(Theme theme);
+  Theme theme() const { return m_theme; }
+  void setDoorOpen(bool open);
+  void setAppSymbol(int slot, const char* symbol);  // nullptr: empty slot
+  void setGame(int slot, const Ion::ExternalApps::App* app);
+  void setFlicker(int levels) { m_flicker = levels; }
+  void setWave(bool wave) { m_wave = wave; }
+  // Half horizontal resolution, if the calculator cannot keep up
+  void setLowResolution(bool low) { m_lowResolution = low; }
+  bool lowResolution() const { return m_lowResolution; }
+
+  // Map
+  char cell(int x, int y) const;
+  static bool isSolid(char c);
+  static bool isFloor(char c) { return !isSolid(c); }
+  // Initial map markers (coins '*', start 'S', ghost '&')
+  static char initialCell(int x, int y);
+
+  // Raycasts every column and projects the sprites
+  void prepare(const Camera& cam, uint32_t timeMs, const Sprite* sprites,
+               int numberOfSprites);
+  // Draws world and sprites into the band
+  void render(Band& b) const;
+  const Target& target() const { return m_target; }
+  KDColor fogColor() const { return m_fog; }
+  KDColor neonColor() const { return m_neon; }
+
+ private:
+  struct Column {
+    float distance;
+    int16_t top, bottom;  // unclipped wall span [top, bottom)
+    int32_t vStep;        // texel step per pixel, 16.16
+    uint8_t tex;          // texture index
+    uint8_t u;            // texel column
+    uint8_t shade;        // fog level 0..15
+    int8_t slot;          // portal / cabinet slot, -1 otherwise
+    uint8_t cellHash;     // varies the animated textures from cell to cell
+  };
+  struct Projected {
+    int16_t sx, sy, half;
+    float depth;
+    SpriteKind kind;
+    uint8_t param;
+    uint8_t shade;
+    float spin;  // coins: width factor of the spinning disc
+  };
+  enum Texture : uint8_t {
+    TexWall = 0,
+    TexAccent,
+    TexMonolith,
+    TexDoor,
+    TexSecret,
+    TexPortal,
+    TexCabinet,
+    TexTrophy,
+    NumberOfTextures
+  };
+  // Special texel values (above the 64 palette colours)
+  constexpr static uint8_t k_portalInside = 255;
+  constexpr static uint8_t k_screenInside = 254;
+  constexpr static uint8_t k_rainbow = 253;
+  constexpr static uint8_t k_rain = 252;
+  constexpr static uint8_t k_glyph = 251;
+
+  void generateTextures();
+  void buildShades();
+  KDColor wallTexel(const Column& c, int v) const;
+  KDColor skyPixel(int x, int y) const;
+  KDColor spritePixel(const Projected& p, int x, int y, bool* hit) const;
+
+  Theme m_theme;
+  bool m_doorOpen;
+  bool m_wave;
+  bool m_lowResolution;
+  int m_flicker;
+  uint32_t m_time;
+  Camera m_cam;
+  float m_dirX, m_dirY, m_planeX, m_planeY;
+  int m_horizon;
+  Target m_target;
+  KDColor m_fog, m_neon;
+  float m_fogK;
+  bool m_hasCeiling;
+
+  uint8_t m_textures[NumberOfTextures][k_tex * k_tex];
+  uint8_t m_floor[k_tex * k_tex];
+  uint8_t m_ceiling[k_tex * k_tex];
+  uint8_t m_swirl[k_tex * k_tex];
+  KDColor m_palette[64];
+  KDColor m_shades[16][64];
+  KDColor m_portalRamp[16];
+  KDColor m_skyRows[k_screenHeight];
+  uint32_t m_appSymbols[k_appSlots][32];
+  uint32_t m_appOutlines[k_appSlots][32];
+  bool m_appUsed[k_appSlots];
+  uint32_t m_monolithMask[32];
+  uint32_t m_doorMask[32];
+  uint16_t m_gameIcons[k_gameSlots][24 * 18];
+  int8_t m_gameState[k_gameSlots];  // -1 empty, 0 no icon, 1 icon
+  Column m_columns[k_screenWidth];
+  // Sky, computed once per frame
+  int16_t m_skyWx[k_screenWidth];  // horizontal sky coordinate of each column
+  uint8_t m_skyRay[k_screenWidth];  // underwater light rays
+  int16_t m_sunX;
+  int16_t m_pulse;  // glowing glyphs, 110..250
+  bool m_sunVisible;
+  Projected m_sprites[k_maxSprites];
+  int m_numberOfSprites;
+  // Per-row floor data for the band being drawn is computed on the fly
+};
+
+}  // namespace Verse
+}  // namespace Home
diff --git a/epsilon/apps/home/verse/gfx.cpp b/epsilon/apps/home/verse/gfx.cpp
new file mode 100644
index 0000000000..0993443829
--- /dev/null
+++ b/epsilon/apps/home/verse/gfx.cpp
@@ -0,0 +1,515 @@
+#include "gfx.h"
+
+#include <kandinsky/context.h>
+#include <math.h>
+#include <omg/memory.h>
+#include <string.h>
+
+namespace Home {
+namespace Verse {
+
+namespace {
+
+KDColor s_band[k_screenWidth * Band::k_maxHeight];
+
+/* Text is rasterized white on black in this buffer; the green channel is
+ * then the glyph coverage. The buffer also receives decompressed .nwa
+ * icons (never at the same time). */
+constexpr int k_textBufferWidth = 240;
+constexpr int k_textBufferHeight = 18;
+KDColor s_textBuffer[k_textBufferWidth * k_textBufferHeight];
+
+constexpr int k_nwaIconWidth = 55;
+constexpr int k_nwaIconHeight = 56;
+static_assert(k_nwaIconWidth * k_nwaIconHeight <=
+                  k_textBufferWidth * k_textBufferHeight,
+              "The text buffer must be able to hold a .nwa icon");
+
+class TextContext : public KDContext {
+ public:
+  TextContext()
+      : KDContext(KDPointZero,
+                  KDRect(0, 0, k_textBufferWidth, k_textBufferHeight)) {}
+
+ protected:
+  void pushRect(KDRect rect, const KDColor* pixels) override {
+    for (KDCoordinate j = 0; j < rect.height(); j++) {
+      memcpy(s_textBuffer + (rect.y() + j) * k_textBufferWidth + rect.x(),
+             pixels + j * rect.width(), rect.width() * sizeof(KDColor));
+    }
+  }
+  void pushRectUniform(KDRect rect, KDColor color) override {
+    for (KDCoordinate j = 0; j < rect.height(); j++) {
+      KDColor* r = s_textBuffer + (rect.y() + j) * k_textBufferWidth + rect.x();
+      for (KDCoordinate i = 0; i < rect.width(); i++) {
+        r[i] = color;
+      }
+    }
+  }
+  void pullRect(KDRect rect, KDColor* pixels) override {
+    for (KDCoordinate j = 0; j < rect.height(); j++) {
+      memcpy(pixels + j * rect.width(),
+             s_textBuffer + (rect.y() + j) * k_textBufferWidth + rect.x(),
+             rect.width() * sizeof(KDColor));
+    }
+  }
+};
+
+/* Epsilon's fonts draw accented letters as a base letter followed by a
+ * combining mark (the translations are stored that way). The NUMVERSE texts
+ * are written with precomposed letters: decompose them on the fly. */
+const char* decompose(const char* s, char* buffer, int size) {
+  // Base letter and combining mark (second byte after 0xCC) for C3 80..9F
+  static constexpr char k_base[32] = {
+      'A', 'A', 'A', 0,   'A', 0,   0,   'C', 'E', 'E', 'E', 'E', 'I', 'I',
+      'I', 'I', 0,   0,   'O', 'O', 'O', 0,   'O', 0,   0,   'U', 'U', 'U',
+      'U', 0,   0,   0};
+  static constexpr uint8_t k_mark[32] = {
+      0x80, 0x81, 0x82, 0,    0x88, 0,    0,    0xA7, 0x80, 0x81, 0x82,
+      0x88, 0x80, 0x81, 0x82, 0x88, 0,    0,    0x80, 0x81, 0x82, 0,
+      0x88, 0,    0,    0x80, 0x81, 0x82, 0x88, 0,    0,    0};
+  bool needed = false;
+  for (const char* p = s; *p; p++) {
+    if (static_cast<uint8_t>(*p) == 0xC3) {
+      needed = true;
+      break;
+    }
+  }
+  if (!needed) {
+    return s;
+  }
+  int n = 0;
+  for (const char* p = s; *p && n < size - 4; p++) {
+    uint8_t c = static_cast<uint8_t>(*p);
+    uint8_t next = static_cast<uint8_t>(p[1]);
+    if (c == 0xC3 && next >= 0x80 && next <= 0xBF) {
+      int i = next >= 0xA0 ? next - 0xA0 : next - 0x80;
+      if (k_base[i]) {
+        char base = k_base[i];
+        if (next >= 0xA0) {
+          base = base - 'A' + 'a';
+        }
+        buffer[n++] = base;
+        buffer[n++] = static_cast<char>(0xCC);
+        buffer[n++] = static_cast<char>(k_mark[i]);
+        p++;
+        continue;
+      }
+    }
+    buffer[n++] = *p;
+  }
+  buffer[n] = 0;
+  return buffer;
+}
+
+// Renders s into the text buffer; returns its size
+KDSize rasterize(const char* s, KDFont::Size font) {
+  KDSize size = KDFont::Font(font)->stringSize(s);
+  int w = size.width() < k_textBufferWidth ? size.width() : k_textBufferWidth;
+  int h = size.height() < k_textBufferHeight ? size.height()
+                                             : k_textBufferHeight;
+  TextContext ctx;
+  ctx.fillRect(KDRect(0, 0, w, h), KDBlack);
+  ctx.drawString(s, KDPointZero,
+                 {.glyphColor = KDWhite,
+                  .backgroundColor = KDBlack,
+                  .font = font});
+  return KDSize(w, h);
+}
+
+/* Coverage (0..256) of the pixel (px, py) of a rounded rectangle, 0 outside.
+ * Only the corners are curved; they are antialiased on one pixel. */
+int roundCoverage(const Rect& r, int radius, int px, int py) {
+  int cx, cy;
+  if (px < r.x + radius) {
+    cx = r.x + radius;
+  } else if (px >= r.right() - radius) {
+    cx = r.right() - radius - 1;
+  } else {
+    return 256;
+  }
+  if (py < r.y + radius) {
+    cy = r.y + radius;
+  } else if (py >= r.bottom() - radius) {
+    cy = r.bottom() - radius - 1;
+  } else {
+    return 256;
+  }
+  float dx = (px - cx) + (px < cx ? 0.5f : -0.5f);
+  float dy = (py - cy) + (py < cy ? 0.5f : -0.5f);
+  float d = sqrtf(dx * dx + dy * dy);
+  float edge = radius + 0.5f - d;
+  if (edge >= 1.f) {
+    return 256;
+  }
+  if (edge <= 0.f) {
+    return 0;
+  }
+  return static_cast<int>(edge * 256);
+}
+
+}  // namespace
+
+/* ------------------------------------------------------------------ rect */
+
+Rect Rect::intersection(const Rect& o) const {
+  int x0 = x > o.x ? x : o.x;
+  int y0 = y > o.y ? y : o.y;
+  int x1 = right() < o.right() ? right() : o.right();
+  int y1 = bottom() < o.bottom() ? bottom() : o.bottom();
+  return {x0, y0, x1 - x0, y1 - y0};
+}
+
+/* ------------------------------------------------------------------ band */
+
+void Band::begin(Rect area) {
+  m_area = area;
+  m_clip = area;
+}
+
+bool Band::setClip(Rect r) {
+  m_clip = r.intersection(m_area);
+  return !m_clip.isEmpty();
+}
+
+KDColor* Band::row(int y) const {
+  return s_band + (y - m_area.y) * m_area.w - m_area.x;
+}
+
+const KDColor* Band::pixels() const { return s_band; }
+
+/* ---------------------------------------------------------------- colors */
+
+KDColor mix(KDColor a, KDColor b, int t) {
+  if (t <= 0) {
+    return a;
+  }
+  if (t >= 256) {
+    return b;
+  }
+  return KDColor::Blend(b, a, static_cast<uint8_t>(t > 255 ? 255 : t));
+}
+
+KDColor hsv(int hue, int sat, int val) {
+  hue %= 360;
+  if (hue < 0) {
+    hue += 360;
+  }
+  int region = hue / 60;
+  int rem = (hue - region * 60) * 255 / 60;
+  int p = (val * (255 - sat)) >> 8;
+  int q = (val * (255 - ((sat * rem) >> 8))) >> 8;
+  int t = (val * (255 - ((sat * (255 - rem)) >> 8))) >> 8;
+  int r, g, b;
+  switch (region) {
+    case 0: r = val; g = t; b = p; break;
+    case 1: r = q; g = val; b = p; break;
+    case 2: r = p; g = val; b = t; break;
+    case 3: r = p; g = q; b = val; break;
+    case 4: r = t; g = p; b = val; break;
+    default: r = val; g = p; b = q; break;
+  }
+  return KDColor::RGB888(r, g, b);
+}
+
+/* ------------------------------------------------------------ primitives */
+
+void fill(Band& b, Rect r, KDColor c, int alpha) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    if (alpha >= 256) {
+      for (int x = z.x; x < z.right(); x++) {
+        row[x] = c;
+      }
+    } else {
+      for (int x = z.x; x < z.right(); x++) {
+        row[x] = KDColor::Blend(c, row[x], static_cast<uint8_t>(alpha));
+      }
+    }
+  }
+}
+
+void frame(Band& b, Rect r, KDColor c, int alpha) {
+  fill(b, {r.x, r.y, r.w, 1}, c, alpha);
+  fill(b, {r.x, r.bottom() - 1, r.w, 1}, c, alpha);
+  fill(b, {r.x, r.y + 1, 1, r.h - 2}, c, alpha);
+  fill(b, {r.right() - 1, r.y + 1, 1, r.h - 2}, c, alpha);
+}
+
+void roundFill(Band& b, Rect r, int radius, KDColor c, int alpha) {
+  if (radius <= 0) {
+    return fill(b, r, c, alpha);
+  }
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    bool cornerRow = y < r.y + radius || y >= r.bottom() - radius;
+    for (int x = z.x; x < z.right(); x++) {
+      int a = alpha;
+      if (cornerRow) {
+        int cov = roundCoverage(r, radius, x, y);
+        if (cov == 0) {
+          continue;
+        }
+        a = (alpha * cov) >> 8;
+      }
+      blendPixel(row + x, c, a);
+    }
+  }
+}
+
+void roundFrame(Band& b, Rect r, int radius, KDColor c, int alpha) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  Rect inner = {r.x + 1, r.y + 1, r.w - 2, r.h - 2};
+  int innerRadius = radius > 1 ? radius - 1 : 0;
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    for (int x = z.x; x < z.right(); x++) {
+      int outer = roundCoverage(r, radius, x, y);
+      if (outer == 0) {
+        continue;
+      }
+      int in = inner.contains(x, y) ? roundCoverage(inner, innerRadius, x, y)
+                                    : 0;
+      int cov = outer - in;
+      if (cov > 0) {
+        blendPixel(row + x, c, (alpha * cov) >> 8);
+      }
+    }
+  }
+}
+
+void disc(Band& b, int cx, int cy, int radius, KDColor c, int alpha) {
+  roundFill(b, {cx - radius, cy - radius, 2 * radius + 1, 2 * radius + 1},
+            radius, c, alpha);
+}
+
+void bitmap(Band& b, const uint16_t* rows, int w, int h, int x, int y,
+            int scale, KDColor c, int alpha) {
+  Rect z = Rect{x, y, w * scale, h * scale}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    uint16_t bits = rows[(yy - y) / scale];
+    KDColor* row = b.row(yy);
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int bx = (xx - x) / scale;
+      if (bits & (0x8000 >> bx)) {
+        blendPixel(row + xx, c, alpha);
+      }
+    }
+  }
+}
+
+void gameIcon(Band& b, const Ion::ExternalApps::App& app, int x, int y,
+              int size) {
+  Rect z = Rect{x, y, size, size}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  const uint8_t* data = app.iconData();
+  uint32_t dataSize = app.iconSize();
+  if (data == nullptr || dataSize == 0) {
+    roundFill(b, {x, y, size, size}, size / 5, rgb(0x7B2FF7));
+    return;
+  }
+  OMG::Memory::Decompress(data, reinterpret_cast<uint8_t*>(s_textBuffer),
+                          dataSize,
+                          k_nwaIconWidth * k_nwaIconHeight * sizeof(KDColor));
+  Rect r = {x, y, size, size};
+  int radius = size / 5;
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const KDColor* src =
+        s_textBuffer + ((yy - y) * k_nwaIconHeight / size) * k_nwaIconWidth;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int cov = roundCoverage(r, radius, xx, yy);
+      if (cov) {
+        blendPixel(row + xx, src[(xx - x) * k_nwaIconWidth / size], cov);
+      }
+    }
+  }
+}
+
+bool gameIconTexture(const Ion::ExternalApps::App& app, uint16_t* out, int w,
+                     int h) {
+  const uint8_t* data = app.iconData();
+  uint32_t dataSize = app.iconSize();
+  if (data == nullptr || dataSize == 0) {
+    return false;
+  }
+  OMG::Memory::Decompress(data, reinterpret_cast<uint8_t*>(s_textBuffer),
+                          dataSize,
+                          k_nwaIconWidth * k_nwaIconHeight * sizeof(KDColor));
+  for (int y = 0; y < h; y++) {
+    for (int x = 0; x < w; x++) {
+      out[y * w + x] = s_textBuffer[(y * k_nwaIconHeight / h) * k_nwaIconWidth +
+                                    x * k_nwaIconWidth / w];
+    }
+  }
+  return true;
+}
+
+/* ------------------------------------------------------------------ text */
+
+int glyphWidth(KDFont::Size font) { return KDFont::GlyphMaxWidth(font); }
+int glyphHeight(KDFont::Size font) { return KDFont::GlyphHeight(font); }
+
+int textWidth(const char* s, KDFont::Size font) {
+  char buffer[96];
+  s = decompose(s, buffer, sizeof(buffer));
+  return KDFont::Font(font)->stringSize(s).width();
+}
+
+void text(Band& b, const char* s, int x, int y, KDColor c, KDFont::Size font,
+          Align align, int maxWidth, int alpha) {
+  if (s == nullptr || s[0] == 0 || alpha <= 0) {
+    return;
+  }
+  char decomposed[96];
+  s = decompose(s, decomposed, sizeof(decomposed));
+  int h = glyphHeight(font);
+  if (y >= b.clip().bottom() || y + h <= b.clip().y) {
+    return;
+  }
+  constexpr int k_maxChars = 48;
+  char buffer[k_maxChars + 4];
+  int gw = glyphWidth(font);
+  int limit =
+      (maxWidth < k_textBufferWidth ? maxWidth : k_textBufferWidth) / gw;
+  int len = strlen(s);
+  if (limit <= 0) {
+    return;
+  }
+  if (len > limit || len > k_maxChars) {
+    int keep = limit < k_maxChars ? limit : k_maxChars;
+    while (keep > 0 && (static_cast<uint8_t>(s[keep]) & 0xC0) == 0x80) {
+      keep--;
+    }
+    memcpy(buffer, s, keep);
+    buffer[keep] = 0;
+    s = buffer;
+  }
+  int w = KDFont::Font(font)->stringSize(s).width();
+  if (w > k_textBufferWidth) {
+    w = k_textBufferWidth;
+  }
+  if (align == Align::Center) {
+    x -= w / 2;
+  } else if (align == Align::Right) {
+    x -= w;
+  }
+  Rect z = Rect{x, y, w, h}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  rasterize(s, font);
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const KDColor* src = s_textBuffer + (yy - y) * k_textBufferWidth - x;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int a = src[xx].green();
+      if (a) {
+        a = a >= 252 ? 256 : a;
+        blendPixel(row + xx, c, (a * alpha) >> 8);
+      }
+    }
+  }
+}
+
+void outlinedText(Band& b, const char* s, int x, int y, KDColor c,
+                  KDFont::Size font, Align align) {
+  KDColor dark = rgb(0x0A0614);
+  text(b, s, x - 1, y, dark, font, align, k_screenWidth, 200);
+  text(b, s, x + 1, y, dark, font, align, k_screenWidth, 200);
+  text(b, s, x, y - 1, dark, font, align, k_screenWidth, 200);
+  text(b, s, x, y + 1, dark, font, align, k_screenWidth, 200);
+  text(b, s, x, y, c, font, align);
+}
+
+void bigText(Band& b, const char* s, int x, int y, int scale, KDColor c,
+             Align align, int alpha) {
+  if (s == nullptr || s[0] == 0 || alpha <= 0) {
+    return;
+  }
+  char decomposed[96];
+  s = decompose(s, decomposed, sizeof(decomposed));
+  KDSize size = KDFont::Font(KDFont::Size::Large)->stringSize(s);
+  int w = (size.width() < k_textBufferWidth ? size.width() : k_textBufferWidth);
+  int h = size.height() < k_textBufferHeight ? size.height()
+                                             : k_textBufferHeight;
+  if (align == Align::Center) {
+    x -= w * scale / 2;
+  } else if (align == Align::Right) {
+    x -= w * scale;
+  }
+  Rect z = Rect{x, y, w * scale, h * scale}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  rasterize(s, KDFont::Size::Large);
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const KDColor* src = s_textBuffer + ((yy - y) / scale) * k_textBufferWidth;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int a = src[(xx - x) / scale].green();
+      if (a) {
+        a = a >= 252 ? 256 : a;
+        blendPixel(row + xx, c, (a * alpha) >> 8);
+      }
+    }
+  }
+}
+
+void glyphMask(const char* s, uint32_t* mask) {
+  for (int i = 0; i < 32; i++) {
+    mask[i] = 0;
+  }
+  if (s == nullptr || s[0] == 0) {
+    return;
+  }
+  char decomposed[48];
+  s = decompose(s, decomposed, sizeof(decomposed));
+  KDSize size = rasterize(s, KDFont::Size::Large);
+  int w = size.width(), h = size.height();
+  if (w <= 0 || h <= 0) {
+    return;
+  }
+  // Fit in 26 x 22 texels, centred, keeping the aspect ratio
+  float scale = 26.f / w;
+  if (22.f / h < scale) {
+    scale = 22.f / h;
+  }
+  int dw = static_cast<int>(w * scale), dh = static_cast<int>(h * scale);
+  int ox = (32 - dw) / 2, oy = (32 - dh) / 2 + 1;
+  for (int y = 0; y < dh; y++) {
+    int sy0 = static_cast<int>(y / scale), sy1 = static_cast<int>((y + 1) / scale);
+    for (int x = 0; x < dw; x++) {
+      int sx0 = static_cast<int>(x / scale), sx1 = static_cast<int>((x + 1) / scale);
+      int best = 0;
+      for (int sy = sy0; sy <= sy1 && sy < h; sy++) {
+        for (int sx = sx0; sx <= sx1 && sx < w; sx++) {
+          int g = s_textBuffer[sy * k_textBufferWidth + sx].green();
+          best = g > best ? g : best;
+        }
+      }
+      if (best > 140) {
+        mask[oy + y] |= 0x80000000u >> (ox + x);
+      }
+    }
+  }
+}
