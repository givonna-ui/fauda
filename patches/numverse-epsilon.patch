+void glitchBand(Band& b) {
+  const Rect& a = b.area();
+  for (int y = a.y; y < a.bottom(); y++) {
+    uint32_t h = hash(y * 7 + s.now / 45);
+    KDColor* row = b.row(y);
+    if ((h & 3) == 0) {
+      int off = static_cast<int>((h >> 4) % 50) - 25;
+      KDColor tmp[k_screenWidth];
+      for (int x = 0; x < k_screenWidth; x++) {
+        int sx = x + off;
+        sx = sx < 0 ? sx + k_screenWidth : (sx >= k_screenWidth ? sx - k_screenWidth : sx);
+        tmp[x] = row[sx];
+      }
+      memcpy(row, tmp, sizeof(tmp));
+    }
+    if ((h & 15) == 1) {
+      for (int x = 0; x < k_screenWidth; x++) {
+        KDColor c = row[x];
+        row[x] = KDColor::RGB888(c.blue(), 255 - c.red(), c.green());
+      }
+    }
+  }
+  if ((s.now / 100) & 1) {
+    outlinedText(b, "R\xC3\x89""ALIT\xC3\x89 CORROMPUE", k_screenWidth / 2, 60,
+                 rgb(0xFF3050), Large, Align::Center);
+  }
+}
