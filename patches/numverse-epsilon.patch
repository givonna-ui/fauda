+void drawHud(Band& b) {
+  KDColor neon = s_engine->neonColor();
+  // Theme
+  const char* name = k_themeNames[static_cast<int>(s.theme)];
+  int w = textWidth(name) + 22;
+  roundFill(b, {4, 4, w, 16}, 8, rgb(0x000000), 130);
+  disc(b, 12, 12, 3, neon);
+  text(b, name, 19, 5, rgb(0xFFFFFF));
+  // Coins and battery
+  char coins[16];
+  int n = coinCount();
+  int l = 0;
+  coins[l++] = '\xCF';
+  coins[l++] = '\x80';
+  coins[l++] = ' ';
+  if (n >= 10) {
+    coins[l++] = '0' + n / 10;
+  }
+  coins[l++] = '0' + n % 10;
+  coins[l++] = '/';
+  coins[l++] = '0' + s_numberOfCoins / 10;
+  coins[l++] = '0' + s_numberOfCoins % 10;
+  coins[l] = 0;
+  int cw = textWidth(coins) + 40;
+  roundFill(b, {k_screenWidth - 4 - cw, 4, cw, 16}, 8, rgb(0x000000), 130);
+  text(b, coins, k_screenWidth - 30, 5, rgb(0xFFD23F), Small, Align::Right);
+  drawBattery(b, k_screenWidth - 26, 7);
+  drawCompass(b);
+  // Crosshair and what you are looking at
+  bool openable;
+  const char* label = targetLabel(s_engine->target(), &openable);
+  int cx = k_screenWidth / 2, cy = k_screenHeight / 2;
+  KDColor cross = label ? neon : rgb(0xFFFFFF);
+  int arm = label ? 5 : 3;
+  fill(b, {cx - arm, cy, 2 * arm + 1, 1}, cross, 220);
+  fill(b, {cx, cy - arm, 1, 2 * arm + 1}, cross, 220);
+  if (label) {
+    int tw = textWidth(label) + (openable ? 34 : 16);
+    Rect r = {cx - tw / 2, 150, tw, 22};
+    roundFill(b, r, 11, rgb(0x0A0614), 200);
+    roundFrame(b, r, 11, neon);
+    int tx = r.x + 8;
+    if (openable) {
+      roundFill(b, {tx, r.y + 4, 22, 14}, 4, neon);
+      text(b, "OK", tx + 11, r.y + 4, rgb(0x0A0614), Small, Align::Center);
+      tx += 26;
+    }
+    text(b, label, tx, r.y + 4, rgb(0xFFFFFF));
+  }
+  // Turbo speed lines
+  if (s.speed > 3.4f) {
+    for (int i = 0; i < 10; i++) {
+      uint32_t h = hash(i * 31 + s.now / 50);
+      int y = static_cast<int>(h % k_screenHeight);
+      int len = 20 + static_cast<int>((h >> 8) % 40);
+      int x = (h >> 16) & 1 ? 0 : k_screenWidth - len;
+      fill(b, {x, y, len, 1}, rgb(0xFFFFFF), 150);
+    }
+    outlinedText(b, "TURBO", cx, 24, rgb(0xFFD23F), Small, Align::Center);
+  }
+  drawBip(b);
+  drawBubble(b);
+}
