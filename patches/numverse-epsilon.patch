+/* ============================================================ teleport */
+
+struct Entry {
+  enum Kind : uint8_t { Place, App, Game } kind;
+  int8_t index;
+};
+
+struct Place {
+  const char* name;
+  float x, y, angle;
+};
+
+constexpr Place k_places[] = {
+    {"Hall des portails", 3.5f, 5.5f, 0.f},
+    {"Salle d'arcade", 18.5f, 6.5f, -1.5708f},
+    {"Labyrinthe du Glitch", 19.5f, 11.5f, 1.5708f},
+    {"Salle secr\xC3\xA8te", 3.5f, 16.5f, -1.5708f},
+};
+
+int entryCount() {
+  return (doorOpen() ? 4 : 3) + s_numberOfBuiltin + s_numberOfGames;
+}
+
+Entry entryAt(int i) {
+  int places = doorOpen() ? 4 : 3;
+  if (i < places) {
+    return {Entry::Place, static_cast<int8_t>(i)};
+  }
+  i -= places;
+  if (i < s_numberOfBuiltin) {
+    return {Entry::App, static_cast<int8_t>(i)};
+  }
+  return {Entry::Game, static_cast<int8_t>(i - s_numberOfBuiltin)};
+}
+
+const char* entryLabel(Entry e) {
+  switch (e.kind) {
+    case Entry::Place:
+      return k_places[e.index].name;
+    case Entry::App:
+      return builtinLabel(e.index);
+    default:
+      return gameLabel(e.index);
+  }
+}
+
+constexpr int k_menuRows = 8;
+
+void activateEntry(Entry e) {
+  switch (e.kind) {
+    case Entry::Place: {
+      const Place& p = k_places[e.index];
+      placeAt(p.x, p.y, p.angle < 0 ? p.angle + 2 * k_pi : p.angle);
+      s.mode = Mode::World;
+      s.flashUntil = s.now + 300;
+      s.glitchUntil = s.now + 250;
+      say("Fzzzt ! T\xC3\xA9l\xC3\xA9portation r\xC3\xA9ussie.\nTous tes atomes sont l\xC3\xA0.",
+          Mood::Wow, 1);
+      break;
+    }
+    case Entry::App:
+      s.mode = Mode::World;
+      openSlotApp(e.index);
+      break;
+    default:
+      s.mode = Mode::World;
+      openGame(e.index);
+      break;
+  }
+}
