+/* ============================================================== launch */
+
+void warpTo(Item item, const char* label) {
+  /* A short dimensional jump before opening the app. The screen is drawn
+   * directly here: the app is opened right after. */
+  s.mode = Mode::Warp;
+  s.warpStart = clockMs();
+  s.warpLabel = label;
+  Band band;
+  while (!s_fake) {
+    s.now = clockMs();
+    if (s.now - s.warpStart > 750) {
+      break;
+    }
+    for (int y = 0; y < k_screenHeight; y += Band::k_maxHeight) {
+      Rect area = {0, y, k_screenWidth, Band::k_maxHeight};
+      band.begin(area);
+      Shell::render(band);
+      Ion::Display::pushRect(KDRect(area.x, area.y, area.w, area.h),
+                             band.pixels());
+    }
+  }
+  s.mode = Mode::World;
+  s.launches++;
+  s_launch = item;
+}
+
+void openSlotApp(int slot) {
+  warpTo({Item::Kind::Builtin, s_builtin[slot]}, builtinLabel(slot));
+}
+
+void openGame(int slot) {
+  warpTo({Item::Kind::External, static_cast<int16_t>(slot)}, gameLabel(slot));
+}
+
+const char* targetLabel(const Target& t, bool* openable) {
+  *openable = false;
+  if (t.distance > 2.3f) {
+    return nullptr;
+  }
+  if (t.cell >= 'a' && t.cell <= 'n') {
+    int slot = t.cell - 'a';
+    if (slot < s_numberOfBuiltin) {
+      *openable = true;
+      return builtinLabel(slot);
+    }
+    return nullptr;
+  }
+  if (t.cell >= 'A' && t.cell <= 'H') {
+    int slot = t.cell - 'A';
+    if (slot < s_numberOfGames) {
+      *openable = true;
+      return gameLabel(slot);
+    }
+    return "Borne vide";
+  }
+  switch (t.cell) {
+    case 'M':
+      return "Monolithe";
+    case 'T':
+      *openable = true;
+      return "Troph\xC3\xA9""e \xCF\x80";
+    case '=':
+      return "Porte secr\xC3\xA8te";
+    default:
+      return nullptr;
+  }
+}
+
+void interact() {
+  const Target& t = s_engine->target();
+  if (t.distance > 2.3f) {
+    say(k_bump[rnd() % 3], Mood::Happy, 1);
+    return;
+  }
+  if (t.cell >= 'a' && t.cell <= 'n') {
+    int slot = t.cell - 'a';
+    if (slot < s_numberOfBuiltin) {
+      openSlotApp(slot);
+    } else {
+      say("Ce portail est \xC3\xA9teint.\nIl attend une appli.", Mood::Bored, 1);
+    }
+    return;
+  }
+  if (t.cell >= 'A' && t.cell <= 'H') {
+    int slot = t.cell - 'A';
+    if (slot < s_numberOfGames) {
+      openGame(slot);
+    } else {
+      say("Borne vide. Ajoute des jeux\n.nwa avec l'installateur !",
+          Mood::Bored, 2);
+    }
+    return;
+  }
+  switch (t.cell) {
+    case 'M':
+      s.partyUntil = s.now + 2500;
+      say("NUMVERSE v1.0\nLa r\xC3\xA9""alit\xC3\xA9 est en b\xC3\xAAta.", Mood::Wow, 2);
+      break;
+    case '=': {
+      static char buffer[48];
+      int n = coinCount();
+      strlcpy(buffer, "Ferm\xC3\xA9""e. Il faut 10 \xCF\x80.\nTu en as ", sizeof(buffer));
+      size_t l = strlen(buffer);
+      if (n >= 10) {
+        buffer[l++] = '0' + n / 10;
+      }
+      buffer[l++] = '0' + n % 10;
+      buffer[l++] = '.';
+      buffer[l] = 0;
+      say(buffer, Mood::Angry, 2);
+      break;
+    }
+    case 'T':
+      s.mode = Mode::Credits;
+      s.modeStart = s.now;
+      if (!s.rainbowUnlocked) {
+        s.rainbowUnlocked = true;
+      }
+      break;
+    default:
+      say(k_bump[rnd() % 3], Mood::Angry, 1);
+      break;
+  }
+}
