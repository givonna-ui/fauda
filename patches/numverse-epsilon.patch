+    if (i >= s_numberOfBuiltin) {
+      s_engine->setAppSymbol(i, nullptr);
+      continue;
+    }
+    const AppInfo* info = appInfo(s_builtinName[i]);
+    if (info) {
+      s_engine->setAppSymbol(i, info->symbol);
+    } else {
+      const char* label = builtinLabel(i);
+      int n = 0;
+      while (n < 3 && label[n] && (static_cast<uint8_t>(label[n]) < 0x80)) {
+        fallback[n] = label[n];
+        n++;
+      }
+      fallback[n] = 0;
+      s_engine->setAppSymbol(i, fallback);
+    }
+  }
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  for (int i = 0; i < k_gameSlots; i++) {
+    if (i < s_numberOfGames) {
+      Ion::ExternalApps::App app = container->externalAppAtIndex(i);
+      s_engine->setGame(i, &app);
