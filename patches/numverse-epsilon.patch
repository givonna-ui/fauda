+
+void interact();
+
+void updateWorld(float dt, const Ion::Keyboard::State& keys) {
+  // Intro spin after the boot
+  uint32_t sinceStart = s.now - s.worldStart;
+  bool left = keys.keyDown(Key::Left), right = keys.keyDown(Key::Right);
+  bool up = keys.keyDown(Key::Up), down = keys.keyDown(Key::Down);
+  if (left || right || up || down) {
+    s.lastInput = s.now;
+  }
+  float targetTurn = (right ? 1.f : 0.f) - (left ? 1.f : 0.f);
+  s.turn += (targetTurn - s.turn) * (dt * 12.f > 1.f ? 1.f : dt * 12.f);
+  s.cam.angle += s.turn * 2.5f * dt;
+  if (s.cam.angle > 2 * k_pi) {
+    s.cam.angle -= 2 * k_pi;
+  } else if (s.cam.angle < 0) {
+    s.cam.angle += 2 * k_pi;
+  }
+  float target = 0.f;
+  if (up) {
+    if (s.forwardSince == 0) {
+      s.forwardSince = s.now;
+    }
+    target = (s.now - s.forwardSince > 1300) ? 4.2f : 2.6f;
+  } else {
+    s.forwardSince = 0;
+    if (down) {
+      target = -1.8f;
+    }
+  }
+  s.speed += (target - s.speed) * (dt * 8.f > 1.f ? 1.f : dt * 8.f);
+  if (fabsf(s.speed) > 0.02f) {
+    float dx = cosf(s.cam.angle) * s.speed * dt;
+    float dy = sinf(s.cam.angle) * s.speed * dt;
+    if (!tryMove(dx, dy) && (up || down) && s.now - s.lastBump > 2500) {
+      s.lastBump = s.now;
+      say(k_bump[rnd() % (sizeof(k_bump) / sizeof(k_bump[0]))], Mood::Angry,
+          1);
+    }
+    s.bob += fabsf(s.speed) * dt * 9.f;
+  }
+  // Jump and head bob
+  if (s.vz != 0.f || s.cam.z > 0.5f + 0.03f) {
+    s.cam.z += s.vz * dt;
+    s.vz -= 7.f * dt;
+    if (s.cam.z <= 0.5f) {
+      s.cam.z = 0.5f;
+      s.vz = 0.f;
+    }
+  } else {
+    s.cam.z = 0.5f + (fabsf(s.speed) > 0.1f ? sinf(s.bob) * 0.018f : 0.f);
+  }
+  if (sinceStart < 1600 && s.launches == 0 && s.message.text) {
+    // Fall from the sky while spinning
+    float t = sinceStart / 1600.f;
+    s.cam.z = 0.5f + 0.45f * (1.f - t) * (1.f - t);
+  }
+  markVisited();
+
+  // Coins
+  for (int i = 0; i < s_numberOfCoins; i++) {
+    if (s.coins & (1 << i)) {
+      continue;
+    }
+    float dx = s_coinX[i] + 0.5f - s.cam.x, dy = s_coinY[i] + 0.5f - s.cam.y;
+    if (dx * dx + dy * dy < 0.2f) {
+      s.coins |= 1 << i;
+      burst(k_screenWidth / 2, k_screenHeight / 2, 18);
+      if (doorOpen()) {
+        s_engine->setDoorOpen(true);
+        s.partyUntil = s.now + 4000;
+        s.flashUntil = s.now + 400;
+        say("LES 10 \xCF\x80 !!! La porte\nsecr\xC3\xA8te s'est ouverte !", Mood::Love,
+            3);
+        say("Elle est \xC3\xA0 l'ouest du\nlabyrinthe. Vas-y !", Mood::Wow, 2);
+      } else {
+        say(k_coinLines[rnd() % (sizeof(k_coinLines) / sizeof(k_coinLines[0]))],
+            Mood::Love, 2);
+      }
+    }
+  }
+
+  // The Glitch
+  updateGhost(dt);
+  float gx = s.ghostX - s.cam.x, gy = s.ghostY - s.cam.y;
+  if (gx * gx + gy * gy < 0.25f && s.now > s.ghostCooldown) {
+    s.glitchUntil = s.now + 1100;
+    s.ghostCooldown = s.now + 6000;
+    say("AAAAH LE GLITCH !!!\nOn est o\xC3\xB9 l\xC3\xA0 ?!", Mood::Scared, 3);
+    placeAt(3.5f, 5.5f, 0.f);
+  }
+
+  // Liminal lights flicker
+  if (s.theme == Theme::Liminal) {
+    if (s.now - s.lastFlicker > 90) {
+      s.lastFlicker = s.now;
+      s_engine->setFlicker((rnd() % 40) == 0 ? 4 : 0);
+    }
+  } else {
+    s_engine->setFlicker(0);
+  }
+
+  // BIP comments what you look at, once
+  const Target& t = s_engine->target();
+  if (t.cell >= 'a' && t.cell <= 'n' && t.distance < 2.5f) {
+    int slot = t.cell - 'a';
+    if (slot < s_numberOfBuiltin && !(s.seenPortals & (1 << slot))) {
+      s.seenPortals |= 1 << slot;
+      const AppInfo* info = appInfo(s_builtinName[slot]);
+      if (info) {
+        say(info->line, Mood::Happy, 1);
+      }
+    }
+  }
+
+  // Idle talk
+  uint32_t idle = s.now - s.lastInput;
+  if (idle > 14000 && idle < 40000 && s.now - s.lastIdleTalk > 15000 &&
+      !s.message.text) {
+    s.lastIdleTalk = s.now;
+    say(k_idle[rnd() % (sizeof(k_idle) / sizeof(k_idle[0]))], Mood::Bored, 1);
+  }
+  if (batteryPercent() < 12 && s.now - s.lastIdleTalk > 60000) {
+    s.lastIdleTalk = s.now;
+    say("J'ai faim... de volts.\nBranche-moi vite.", Mood::Bored, 1);
+  }
+}
