+    ctx->fillRectWithPixels(KDRect(area.x, area.y, area.w, area.h),
+                            band.pixels(), nullptr);
+  }
+  if (rect.height() >= Verse::k_screenHeight) {
+    Verse::Shell::setLastRedrawDuration(
+        static_cast<int>(Ion::Timing::millis() - start));
