+bool solidAt(float x, float y) {
+  return Engine::isSolid(s_engine->cell(static_cast<int>(x),
+                                        static_cast<int>(y)));
+}
+
+// Returns false if blocked
+bool tryMove(float dx, float dy) {
+  constexpr float r = 0.22f;
+  bool ok = true;
+  float nx = s.cam.x + dx;
+  float ex = nx + (dx > 0 ? r : -r);
+  if (dx != 0.f) {
+    if (!solidAt(ex, s.cam.y - r) && !solidAt(ex, s.cam.y + r)) {
+      s.cam.x = nx;
+    } else {
+      ok = false;
+    }
+  }
+  float ny = s.cam.y + dy;
+  float ey = ny + (dy > 0 ? r : -r);
+  if (dy != 0.f) {
+    if (!solidAt(s.cam.x - r, ey) && !solidAt(s.cam.x + r, ey)) {
+      s.cam.y = ny;
+    } else {
+      ok = false;
+    }
+  }
+  return ok;
+}
+
+void markVisited() {
+  int cx = static_cast<int>(s.cam.x), cy = static_cast<int>(s.cam.y);
+  for (int y = cy - 2; y <= cy + 2; y++) {
+    for (int x = cx - 2; x <= cx + 2; x++) {
+      if (x >= 0 && y >= 0 && x < k_mapWidth && y < k_mapHeight) {
+        s.visited[y] |= 1u << x;
+      }
+    }
+  }
+}
+
+void placeAt(float x, float y, float angle) {
+  s.cam.x = x;
+  s.cam.y = y;
+  s.cam.angle = angle;
+  s.cam.z = 0.5f;
+  s.vz = 0.f;
+  s.speed = 0.f;
+}
+
+void resetGhost() {
+  for (int y = 0; y < k_mapHeight; y++) {
+    for (int x = 0; x < k_mapWidth; x++) {
+      if (Engine::initialCell(x, y) == '&') {
+        s.ghostX = x + 0.5f;
+        s.ghostY = y + 0.5f;
+        s.ghostTX = s.ghostPX = x;
+        s.ghostTY = s.ghostPY = y;
+      }
+    }
+  }
+}
+
+void updateGhost(float dt) {
+  float tx = s.ghostTX + 0.5f, ty = s.ghostTY + 0.5f;
+  float dx = tx - s.ghostX, dy = ty - s.ghostY;
+  float d = sqrtf(dx * dx + dy * dy);
+  float step = 1.35f * dt;
+  if (d > step) {
+    s.ghostX += dx / d * step;
+    s.ghostY += dy / d * step;
+    return;
+  }
+  s.ghostX = tx;
+  s.ghostY = ty;
+  // Next cell: wander in the maze, hunt the player when close
+  constexpr int dirs[4][2] = {{1, 0}, {-1, 0}, {0, 1}, {0, -1}};
+  int options[4], n = 0;
+  for (int i = 0; i < 4; i++) {
+    int nx = s.ghostTX + dirs[i][0], ny = s.ghostTY + dirs[i][1];
+    if (ny < 11 || !Engine::isFloor(s_engine->cell(nx, ny))) {
+      continue;
+    }
+    if (nx == s.ghostPX && ny == s.ghostPY) {
+      continue;
+    }
+    options[n++] = i;
+  }
+  int choice = -1;
+  if (n == 0) {
+    choice = -2;  // dead end: go back
+  } else {
+    int px = static_cast<int>(s.cam.x), py = static_cast<int>(s.cam.y);
+    int dist = (px > s.ghostTX ? px - s.ghostTX : s.ghostTX - px) +
+               (py > s.ghostTY ? py - s.ghostTY : s.ghostTY - py);
+    if (py >= 11 && dist < 8 && (rnd() % 100) < 65) {
+      int best = 1000;
+      for (int k = 0; k < n; k++) {
+        int nx = s.ghostTX + dirs[options[k]][0];
+        int ny = s.ghostTY + dirs[options[k]][1];
+        int dd = (px > nx ? px - nx : nx - px) + (py > ny ? py - ny : ny - py);
+        if (dd < best) {
+          best = dd;
+          choice = options[k];
+        }
+      }
+    } else {
+      choice = options[rnd() % n];
+    }
+  }
+  int nx, ny;
+  if (choice == -2) {
+    nx = s.ghostPX;
+    ny = s.ghostPY;
+  } else {
+    nx = s.ghostTX + dirs[choice][0];
+    ny = s.ghostTY + dirs[choice][1];
+  }
+  s.ghostPX = s.ghostTX;
+  s.ghostPY = s.ghostTY;
+  s.ghostTX = nx;
+  s.ghostTY = ny;
+}
+
+void setTheme(Theme t, bool talk) {
+  if (t == Theme::Rainbow && !s.rainbowUnlocked) {
+    say("Cette r\xC3\xA9""alit\xC3\xA9 est verrouill\xC3\xA9""e.\nTrouve le troph\xC3\xA9""e \xCF\x80...",
+        Mood::Angry, 2);
+    return;
+  }
+  s.theme = t;
+  s_engine->setTheme(t);
+  s_engine->setWave(t == Theme::Abyss);
+  s.flashUntil = s.now + 250;
+  if (talk) {
+    // A new reality: forget what BIP was about to say about the old one
+    s.queueLength = 0;
+    showMessage({k_themeLines[static_cast<int>(t)],
+                 t == Theme::Liminal ? Mood::Scared : Mood::Happy, 2});
+  }
+}
