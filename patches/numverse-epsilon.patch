+void spawn(int x, int y, int vx, int vy, int life, int kind, KDColor color) {
+  for (Particle& p : s.particles) {
+    if (p.life == 0) {
+      p = {static_cast<int16_t>(x * 4), static_cast<int16_t>(y * 4),
+           static_cast<int8_t>(vx), static_cast<int8_t>(vy),
+           static_cast<uint8_t>(life), static_cast<uint8_t>(kind),
+           static_cast<uint16_t>(color)};
+      return;
+    }
+  }
+}
+
+void burst(int x, int y, int n) {
+  for (int i = 0; i < n; i++) {
+    spawn(x, y, static_cast<int>(rnd() % 25) - 12,
+          static_cast<int>(rnd() % 25) - 16, 25 + rnd() % 20, 0,
+          hsv(rnd() % 360, 200, 255));
+  }
+}
+
+void updateParticles() {
+  for (Particle& p : s.particles) {
+    if (p.life == 0) {
+      continue;
+    }
+    p.life--;
+    p.x += p.vx;
+    p.y += p.vy;
+    if (p.kind == 0 && (s.now & 1)) {
+      p.vy++;  // confetti fall
+    }
+    if (p.kind == 1) {
+      p.x += static_cast<int>(sinf((p.y + p.life * 9) * 0.02f) * 3.f);
+    }
+    if (p.y < -40 || p.y > (k_screenHeight + 10) * 4) {
+      p.life = 0;
+    }
+  }
+  // Ambient particles
+  if (s.mode == Mode::World || s.mode == Mode::Teleport) {
+    if (s.theme == Theme::Abyss && (rnd() & 3) == 0) {
+      spawn(rnd() % k_screenWidth, k_screenHeight, 0,
+            -4 - static_cast<int>(rnd() % 5), 120, 1, rgb(0xBFF4FF));
+    } else if (s.theme == Theme::Liminal && (rnd() & 7) == 0) {
+      spawn(rnd() % k_screenWidth, rnd() % k_screenHeight,
+            static_cast<int>(rnd() % 3) - 1, 1, 60, 2, rgb(0xFFF2B0));
+    }
+  }
+  if (s.now < s.partyUntil) {
+    for (int i = 0; i < 2; i++) {
+      spawn(rnd() % k_screenWidth, -2, static_cast<int>(rnd() % 7) - 3,
+            2 + rnd() % 4, 80, 0, hsv(rnd() % 360, 220, 255));
+    }
+  }
+}
+
+void renderParticles(Band& b) {
+  for (const Particle& p : s.particles) {
+    if (p.life == 0) {
+      continue;
+    }
+    int x = p.x / 4, y = p.y / 4;
+    KDColor c = KDColor::RGB16(p.color);
+    switch (p.kind) {
+      case 1:
+        roundFrame(b, {x - 2, y - 2, 5, 5}, 2, c, 200);
+        break;
+      case 2:
+        fill(b, {x, y, 1, 1}, c, 120);
+        break;
+      default:
+        fill(b, {x, y, (p.life & 4) ? 3 : 2, (p.life & 4) ? 2 : 3}, c);
+        break;
+    }
+  }
+}
