+
+void renderBoot(Band& b) {
+  uint32_t e = s.now - s.modeStart;
+  fill(b, b.area(), rgb(0x000000));
+  // CRT power on
+  if (e < 600) {
+    if (e < 250) {
+      int w = static_cast<int>(e * k_screenWidth / 250);
+      fill(b, {k_screenWidth / 2 - w / 2, k_screenHeight / 2 - 1, w, 2},
+           rgb(0xFFFFFF));
+    } else if (e < 450) {
+      int h = static_cast<int>((e - 250) * k_screenHeight / 200);
+      fill(b, {0, k_screenHeight / 2 - h / 2, k_screenWidth, h},
+           rgb(0xE8F4FF));
+    } else {
+      fill(b, b.area(), rgb(0xFFFFFF), static_cast<int>((600 - e) * 256 / 150));
+    }
+    return;
+  }
+  struct Line {
+    const char* text;
+    const char* status;
+    uint32_t color;
+  };
+  constexpr Line k_lines[] = {
+      {"NUMVERSE BIOS 1.0  (c) BIP Corp.", nullptr, 0},
+      {"CPU : ARM Cortex-M7 @ 216 MHz", "OK", 0x3BFF7A},
+      {"Clavier : 46 touches", "OK", 0x3BFF7A},
+      {"\xC3\x89""cran : 320x240, 65 536 couleurs", "OK", 0x3BFF7A},
+      {"Moteur 3D : 320 rayons / image", "OK", 0x3BFF7A},
+      {"Ennui de l'utilisateur", "\xC3\x89LEV\xC3\x89", 0xFFB020},
+      {"Chargement de reality.dll", "\xC3\x89""CHEC", 0xFF3050},
+      {"> Cr\xC3\xA9""ation d'un monde de secours", nullptr, 0},
+  };
+  constexpr int k_lineCount = sizeof(k_lines) / sizeof(k_lines[0]);
+  constexpr uint32_t k_lineDelay = 300;
+  uint32_t textEnd = 600 + k_lineCount * k_lineDelay;
+  if (e < textEnd + 900) {
+    for (int i = 0; i < k_lineCount; i++) {
+      uint32_t start = 600 + i * k_lineDelay;
+      if (e < start) {
+        break;
+      }
+      int y = 12 + i * 18;
+      char buffer[48];
+      int chars = static_cast<int>((e - start) / 9);
+      int len = strlen(k_lines[i].text);
+      if (chars > len) {
+        chars = len;
+      }
+      memcpy(buffer, k_lines[i].text, chars);
+      buffer[chars] = 0;
+      text(b, buffer, 8, y, i == 0 ? rgb(0xFFFFFF) : rgb(0xB8C4D0));
+      if (k_lines[i].status && chars == len && e > start + 220) {
+        bool blink = k_lines[i].color == 0xFF3050 && ((e / 200) & 1);
+        if (!blink) {
+          text(b, k_lines[i].status, k_screenWidth - 8, y,
+               rgb(k_lines[i].color), Small, Align::Right);
+        }
+      }
+    }
+    // Progress bar with glitches
+    if (e > textEnd) {
+      int p = static_cast<int>((e - textEnd) * 100 / 800);
+      if (p > 100) {
+        p = 100;
+      }
+      Rect bar = {8, 170, k_screenWidth - 16, 14};
+      frame(b, bar, rgb(0x3BFF7A));
+      fill(b, {bar.x + 2, bar.y + 2, (bar.w - 4) * p / 100, bar.h - 4},
+           rgb(0x3BFF7A));
+      for (int i = 0; i < 6; i++) {
+        uint32_t h = hash(i + (e / 70) * 7);
+        if ((h & 3) == 0) {
+          fill(b, {static_cast<int>(h % 300), 190 + static_cast<int>((h >> 9) % 40),
+                   20 + static_cast<int>((h >> 4) % 40), 3},
+               hsv(h % 360, 255, 255));
+        }
+      }
+      char pct[8];
+      int l = 0;
+      if (p >= 100) {
+        pct[l++] = '1';
+      }
+      if (p >= 10) {
+        pct[l++] = '0' + (p / 10) % 10;
+      }
+      pct[l++] = '0' + p % 10;
+      pct[l++] = ' ';
+      pct[l++] = '%';
+      pct[l] = 0;
+      text(b, pct, k_screenWidth / 2, 152, rgb(0x3BFF7A), Small, Align::Center);
+    }
+    // Scanlines
+    for (int y = b.area().y; y < b.area().bottom(); y++) {
+      if ((y & 1) == 0) {
+        fill(b, {0, y, k_screenWidth, 1}, rgb(0x000000), 70);
+      }
+    }
+    return;
+  }
+  // Logo with chromatic aberration
+  uint32_t le = e - textEnd - 900;
+  int shake = le < 400 ? static_cast<int>(hash(le / 40) % 7) - 3 : 0;
+  int cx = k_screenWidth / 2, y = 70;
+  for (int yy = b.area().y; yy < b.area().bottom(); yy++) {
+    // Synthwave grid floor below the logo
+    if (yy > 150) {
+      int d = yy - 150;
+      KDColor c = mix(rgb(0x14002A), rgb(0x000000), 0);
+      fill(b, {0, yy, k_screenWidth, 1}, c);
+      int z = 2000 / (d + 4);
+      if (((z + static_cast<int>(le / 30)) % 8) == 0) {
+        fill(b, {0, yy, k_screenWidth, 1}, rgb(0xFF2FD0), 200);
+      }
+      for (int k = -12; k <= 12; k++) {
+        int x = cx + k * (d + 4) * 3;
+        fill(b, {x, yy, 1, 1}, rgb(0xFF2FD0), 200);
+      }
+    }
+  }
+  bigText(b, "NUMVERSE", cx - 3 + shake, y, 3, rgb(0x00F0FF), Align::Center, 200);
+  bigText(b, "NUMVERSE", cx + 3 - shake, y, 3, rgb(0xFF2E88), Align::Center, 200);
+  bigText(b, "NUMVERSE", cx, y, 3, rgb(0xFFFFFF), Align::Center);
+  text(b, "ta calculatrice est un monde", cx, y + 60, rgb(0xFFB3E6), Small,
+       Align::Center);
+  if ((le / 450) & 1) {
+    text(b, "OK pour entrer", cx, 200, rgb(0xFFFFFF), Small, Align::Center);
+  }
+  if (le < 200) {
+    fill(b, b.area(), rgb(0xFFFFFF), static_cast<int>((200 - le) * 256 / 200));
+  }
+}
+
+void renderWarp(Band& b) {
+  uint32_t e = s.now - s.warpStart;
+  const Rect& a = b.area();
+  KDColor neon = s_engine->neonColor();
+  for (int y = a.y; y < a.bottom(); y++) {
+    KDColor* row = b.row(y);
+    int dy = y - k_screenHeight / 2;
+    dy = dy < 0 ? -dy : dy;
+    for (int x = 0; x < k_screenWidth; x++) {
+      int dx = x - k_screenWidth / 2;
+      dx = dx < 0 ? -dx : dx;
+      int d = dx > dy ? dx + dy / 2 : dy + dx / 2;
+      int ring = ((d >> 3) - static_cast<int>(e / 18)) & 7;
+      int bright = d * 256 / 200;
+      if (bright > 256) {
+        bright = 256;
+      }
+      KDColor c = hsv(250 + ring * 14 + static_cast<int>(e / 6), 200,
+                      40 + bright * 215 / 256);
+      row[x] = ring == 0 ? mix(c, neon, 160) : c;
+    }
+  }
+  if (s.warpLabel) {
+    outlinedText(b, "SAUT DIMENSIONNEL", k_screenWidth / 2, 92, rgb(0xFFFFFF),
+                 Small, Align::Center);
+    outlinedText(b, s.warpLabel, k_screenWidth / 2, 112, rgb(0xFFFFFF), Large,
+                 Align::Center);
+  }
+  if (e > 550) {
+    fill(b, a, rgb(0xFFFFFF), static_cast<int>((e - 550) * 256 / 200));
+  }
+}
+
+void drawBip(Band& b) {
+  Mood mood = currentMood();
+  int x0 = 6, y0 = 190;
+  if (mood == Mood::Scared) {
+    x0 += static_cast<int>(hash(s.now / 40) % 5) - 2;
+  }
+  constexpr int S = 44;
+  KDColor neon = s_engine->neonColor();
+  if (mood == Mood::Wow || mood == Mood::Love) {
+    neon = hsv(s.now / 4, 200, 255);
+  }
+  // Antenna
+  fill(b, {x0 + S / 2, y0 - 7, 2, 7}, rgb(0x8A8AA0));
+  disc(b, x0 + S / 2 + 1, y0 - 8, 2,
+       (s.now / 500) & 1 ? rgb(0xFF3050) : neon);
+  roundFill(b, {x0, y0, S, S}, 9, rgb(0x150C2A), 235);
+  roundFrame(b, {x0, y0, S, S}, 9, neon);
+  int ex[2] = {x0 + 14, x0 + 30};
+  int ey = y0 + 17;
+  int look = static_cast<int>(s.turn * 3.f);
+  KDColor eye = rgb(0xEFFFFF);
+  bool blink = (s.now % 4200) < 130;
+  for (int i = 0; i < 2; i++) {
+    int cx = ex[i] + look;
+    switch (mood) {
+      case Mood::Sleep:
+        fill(b, {cx - 4, ey + 1, 9, 2}, eye);
+        break;
+      case Mood::Bored:
+        fill(b, {cx - 3, ey, 7, 4}, eye);
+        fill(b, {cx - 4, ey - 1, 9, 1}, neon);
+        break;
+      case Mood::Scared:
+        disc(b, cx, ey, 6, eye);
+        disc(b, cx + (i ? -1 : 1), ey + 1, 2, rgb(0x000000));
+        break;
+      case Mood::Love: {
+        static constexpr uint16_t heart[6] = {0x6C00, 0xFE00, 0xFE00,
+                                              0x7C00, 0x3800, 0x1000};
+        bitmap(b, heart, 7, 6, cx - 3, ey - 3, 1, rgb(0xFF3C78));
+        break;
+      }
+      case Mood::Wow:
+        disc(b, cx, ey, 4, hsv(s.now / 3 + i * 120, 200, 255));
+        disc(b, cx, ey, 1, rgb(0xFFFFFF));
+        break;
+      case Mood::Angry:
+        roundFill(b, {cx - 3, ey - 2, 7, 8}, 3, eye);
+        for (int k = 0; k < 7; k++) {
+          int yy = ey - 6 + (i ? 6 - k : k) / 2;
+          fill(b, {cx - 3 + k, yy, 1, 2}, rgb(0xFF3050));
+        }
+        break;
+      default:
+        if (blink) {
+          fill(b, {cx - 3, ey, 7, 2}, eye);
+        } else {
+          roundFill(b, {cx - 3, ey - 5, 7, 10}, 3, eye);
+        }
+        break;
+    }
+  }
+  if (mood == Mood::Cool) {
+    roundFill(b, {x0 + 6, ey - 5, S - 12, 9}, 3, rgb(0x050505));
+    fill(b, {x0 + 9, ey - 3, 6, 1}, rgb(0xFF6AD5));
+    fill(b, {x0 + 25, ey - 3, 6, 1}, rgb(0x6AF3FF));
+  }
+  // Mouth
+  int mx = x0 + S / 2, my = y0 + 32;
+  bool talking = s.message.text && s.now < s.messageEnd &&
+                 (s.now - s.messageStart) < strlen(s.message.text) * 28;
+  if (talking && ((s.now / 90) & 1)) {
+    roundFill(b, {mx - 4, my - 2, 9, 6}, 2, rgb(0xFF5A7A));
+  } else {
+    switch (mood) {
+      case Mood::Bored:
+      case Mood::Sleep:
+        fill(b, {mx - 4, my, 9, 2}, eye);
+        break;
+      case Mood::Scared:
+        roundFrame(b, {mx - 3, my - 2, 7, 7}, 3, eye);
+        break;
+      case Mood::Angry:
+        for (int dx = -5; dx <= 5; dx++) {
+          fill(b, {mx + dx, my + 3 - (25 - dx * dx) / 9, 1, 2}, eye);
+        }
+        break;
+      default:
+        for (int dx = -5; dx <= 5; dx++) {
+          fill(b, {mx + dx, my + (25 - dx * dx) / 9 - 1, 1, 2}, eye);
+        }
+        break;
+    }
+  }
+  if (mood == Mood::Sleep) {
+    int t = static_cast<int>((s.now / 60) % 30);
+    text(b, "z", x0 + S + 2 + t / 3, y0 - t, rgb(0xFFFFFF), Small,
+         Align::Left, k_screenWidth, 255 - t * 8);
+    text(b, "Z", x0 + S + 8 + t / 4, y0 - 12 - t / 2, rgb(0xFFFFFF), Small,
+         Align::Left, k_screenWidth, 200 - t * 6);
+  }
+}
+
+void drawBubble(Band& b) {
+  if (!s.message.text || s.now >= s.messageEnd) {
+    return;
+  }
+  const char* m = s.message.text;
+  int visible = static_cast<int>((s.now - s.messageStart) / 28);
+  // Split in up to two lines
+  char lines[2][44];
+  int n = 0, l = 0, count = 0;
+  lines[0][0] = lines[1][0] = 0;
+  for (const char* p = m; *p && n < 2; p++) {
+    if (count >= visible && (static_cast<uint8_t>(*p) & 0xC0) != 0x80) {
+      break;
+    }
+    if (*p == '\n') {
+      lines[n][l] = 0;
+      n++;
+      l = 0;
+      continue;
+    }
+    if (l < 43) {
+      lines[n][l++] = *p;
+      lines[n][l] = 0;
+    }
+    count++;
+  }
+  int w1 = textWidth(lines[0]), w2 = textWidth(lines[1]);
+  // Width from the whole message, so the bubble does not grow while typing
+  int full = 0, cur = 0;
+  char tmp[44];
+  int tl = 0;
+  for (const char* p = m;; p++) {
+    if (*p == '\n' || *p == 0) {
+      tmp[tl] = 0;
+      cur = textWidth(tmp);
+      full = cur > full ? cur : full;
+      tl = 0;
+      if (*p == 0) {
+        break;
+      }
+      continue;
+    }
+    if (tl < 43) {
+      tmp[tl++] = *p;
+    }
+  }
+  (void)w1;
+  (void)w2;
+  bool two = strchr(m, '\n') != nullptr;
+  int h = two ? 36 : 22;
+  Rect r = {58, 232 - h, full + 16, h};
+  if (r.right() > k_screenWidth - 4) {
+    r.w = k_screenWidth - 4 - r.x;
+  }
+  roundFill(b, r, 8, rgb(0xFFFFFF), 240);
+  // Tail
+  for (int i = 0; i < 6; i++) {
+    fill(b, {r.x - 6 + i, r.bottom() - 12 + i / 2, 1, 6 - i}, rgb(0xFFFFFF),
+         240);
+  }
+  text(b, lines[0], r.x + 8, r.y + 4, rgb(0x1A1030));
+  if (two) {
+    text(b, lines[1], r.x + 8, r.y + 18, rgb(0x1A1030));
+  }
+}
+
+void drawCompass(Band& b) {
+  constexpr int cx = k_screenWidth / 2, w = 136, y = 4;
+  if (!b.setClip({cx - w / 2, y, w, 16})) {
+    b.resetClip();
+    return;
+  }
+  roundFill(b, {cx - w / 2, y, w, 16}, 8, rgb(0x000000), 120);
+  constexpr const char* names[8] = {"E", "SE", "S", "SO", "O", "NO", "N", "NE"};
+  for (int i = 0; i < 8; i++) {
+    float a = i * k_pi / 4.f - s.cam.angle;
+    while (a > k_pi) {
+      a -= 2 * k_pi;
+    }
+    while (a < -k_pi) {
+      a += 2 * k_pi;
+    }
+    int x = cx + static_cast<int>(a * 84.f / (k_pi / 2.f));
+    bool major = (i % 2) == 0;
+    text(b, names[i], x, y + 1, major ? rgb(0xFFFFFF) : rgb(0x9A9AB0), Small,
+         Align::Center);
+  }
+  fill(b, {cx, y, 1, 3}, s_engine->neonColor());
+  b.resetClip();
+}
