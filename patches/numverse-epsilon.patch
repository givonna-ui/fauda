+void say(const char* text, Mood mood = Mood::Happy, uint8_t priority = 1) {
+  bool busy = s.message.text && s.now < s.messageEnd;
+  if (!busy || priority > s.message.priority) {
+    showMessage({text, mood, priority});
+    return;
+  }
+  if (s.queueLength < k_queueSize) {
+    s.queue[s.queueLength++] = {text, mood, priority};
+  }
+}
+
+void updateMessages() {
+  if (s.message.text && s.now >= s.messageEnd) {
+    s.message.text = nullptr;
+    if (s.queueLength > 0) {
+      showMessage(s.queue[0]);
+      for (int i = 1; i < s.queueLength; i++) {
+        s.queue[i - 1] = s.queue[i];
+      }
+      s.queueLength--;
+    }
+  }
+}
