+void drawMap(Band& b) {
+  KDColor neon = s_engine->neonColor();
+  constexpr int C = 8;
+  constexpr int mx = (k_screenWidth - k_mapWidth * C) / 2, my = 46;
+  roundFill(b, {mx - 10, 22, k_mapWidth * C + 20, k_mapHeight * C + 40}, 12,
+            rgb(0x0A0614), 225);
+  roundFrame(b, {mx - 10, 22, k_mapWidth * C + 20, k_mapHeight * C + 40}, 12,
+             neon);
+  int known = 0, total = 0;
+  for (int y = 0; y < k_mapHeight; y++) {
+    for (int x = 0; x < k_mapWidth; x++) {
+      char c = s_engine->cell(x, y);
+      bool seen = s.visited[y] & (1u << x);
+      if (Engine::isFloor(c)) {
+        total++;
+        known += seen ? 1 : 0;
+      }
+      if (!seen) {
+        continue;
+      }
+      Rect r = {mx + x * C, my + y * C, C, C};
+      if (Engine::isFloor(c)) {
+        fill(b, r, neon, 45);
+      } else if (c >= 'a' && c <= 'n') {
+        fill(b, {r.x + 1, r.y + 1, C - 2, C - 2}, rgb(0xFF3CAC));
+      } else if (c >= 'A' && c <= 'H') {
+        fill(b, {r.x + 1, r.y + 1, C - 2, C - 2}, rgb(0xFFD23F));
+      } else if (c == '=') {
+        fill(b, r, rgb(0xFF3050));
+      } else if (c == 'M' || c == 'T') {
+        fill(b, {r.x + 1, r.y + 1, C - 2, C - 2}, rgb(0xFFFFFF));
+      } else {
+        fill(b, r, rgb(0x5A5A78));
+      }
+    }
+  }
+  // Coins
+  for (int i = 0; i < s_numberOfCoins; i++) {
+    if (!(s.coins & (1 << i)) && (s.visited[s_coinY[i]] & (1u << s_coinX[i])) &&
+        ((s.now / 300) & 1)) {
+      disc(b, mx + s_coinX[i] * C + 4, my + s_coinY[i] * C + 4, 2,
+           rgb(0xFFD23F));
+    }
+  }
+  // Ghost
+  int gx = static_cast<int>(s.ghostX), gy = static_cast<int>(s.ghostY);
+  if ((s.visited[gy] & (1u << gx)) && ((s.now / 200) & 1)) {
+    disc(b, mx + static_cast<int>(s.ghostX * C), my + static_cast<int>(s.ghostY * C),
+         3, rgb(0xC9A0FF));
+  }
+  // Player
+  int px = mx + static_cast<int>(s.cam.x * C);
+  int py = my + static_cast<int>(s.cam.y * C);
+  for (int k = 0; k < 7; k++) {
+    fill(b, {px + static_cast<int>(cosf(s.cam.angle) * k),
+             py + static_cast<int>(sinf(s.cam.angle) * k), 1, 1},
+         rgb(0xFFFFFF));
+  }
+  disc(b, px, py, 2, rgb(0xFFFFFF));
+  // Title
+  char title[32];
+  strlcpy(title, "CARTE  -  explor\xC3\xA9""e ", sizeof(title));
+  int pct = total ? known * 100 / total : 0;
+  size_t l = strlen(title);
+  if (pct >= 100) {
+    title[l++] = '1';
+  }
+  if (pct >= 10) {
+    title[l++] = '0' + (pct / 10) % 10;
+  }
+  title[l++] = '0' + pct % 10;
+  title[l++] = '%';
+  title[l] = 0;
+  text(b, title, k_screenWidth / 2, 27, rgb(0xFFFFFF), Small, Align::Center);
+  text(b, "portails  bornes  porte  \xCF\x80", k_screenWidth / 2,
+       my + k_mapHeight * C + 2, rgb(0x9A9AB0), Small, Align::Center);
+}
