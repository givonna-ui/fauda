+Mood currentMood() {
+  if (s.message.text && s.now < s.messageEnd) {
+    return s.message.mood;
+  }
+  if (s.now < s.partyUntil) {
+    return Mood::Wow;
+  }
+  if (s.now < s.glitchUntil) {
+    return Mood::Scared;
+  }
+  uint32_t idle = s.now - s.lastInput;
+  if (idle > 40000) {
+    return Mood::Sleep;
+  }
+  if (idle > 14000) {
+    return Mood::Bored;
+  }
+  return s.theme == Theme::Synthwave ? Mood::Cool : Mood::Happy;
+}
