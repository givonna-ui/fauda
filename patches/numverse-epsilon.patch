+  s_gifFrame = 0;
+  for (int t = 0; t < 6000; t += 60) {
+    s.now = s_fakeClock + t;
+    gifFrame("gifboot");
+  }
+  // Navigation GIF: arrival, walking, realities, party, teleporter
+  s_fakeClock += 6100;
+  s.now = s.last = s_fakeClock;
+  startWorld(true);
+  s_gifFrame = 0;
+  const char* g = "gifnav";
+  step(1700, g);
+  hold(keyBit(Key::Up), 800, g);
+  hold(keyBit(Key::Left), 650, g);
+  hold(keyBit(Key::Up), 450, g);
+  step(500, g);
+  press(Events::Two, 1100, g);
+  hold(keyBit(Key::Right), 900, g);
+  press(Events::Three, 1000, g);
+  hold(keyBit(Key::Up) | keyBit(Key::Right), 700, g);
+  press(Events::Four, 1100, g);
+  hold(keyBit(Key::Left), 600, g);
+  press(Events::Five, 1100, g);
+  press(Events::One, 500, g);
+  press(Events::Pi, 1300, g);
+  press(Events::Back, 500, g);
+  press(Events::Down, 250, g);
+  press(Events::Down, 250, g);
+  press(Events::Down, 250, g);
