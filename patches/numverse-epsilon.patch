+void buildItems() {
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  int builtin = container->numberOfBuiltinApps();
+  s_numberOfBuiltin = 0;
+  for (int appIndex = 1;
+       appIndex < builtin && s_numberOfBuiltin < k_maxBuiltin; appIndex++) {
+    I18n::Message name = container
+                             ->appSnapshotAtIndex(PermutedAppSnapshotIndex(appIndex))
+                             ->descriptor()
+                             ->name();
+    s_builtin[s_numberOfBuiltin] = appIndex;
+    s_builtinName[s_numberOfBuiltin] = name;
+    s_numberOfBuiltin++;
+  }
+  s_numberOfGames = container->numberOfExternalApps();
+  if (s_numberOfGames > k_gameSlots) {
+    s_numberOfGames = k_gameSlots;
+  }
+  s_numberOfCoins = 0;
+  for (int y = 0; y < k_mapHeight; y++) {
+    for (int x = 0; x < k_mapWidth; x++) {
+      if (Engine::initialCell(x, y) == '*' && s_numberOfCoins < k_maxCoins) {
+        s_coinX[s_numberOfCoins] = x;
